<%#REFERENCE ZESABLGeneratorUI.dll, System.Windows.Forms.dll %>
<%#NAMESPACE System, System.Text, System.Collections,System.Collections.Generic, System.Windows.Forms, Zeus, Zeus.UserInterface, Zeus.Templates.DotNetScript, EHA.ZESA.Util.GeneratorUI %>
public class GeneratedGui : DotNetScriptGui
{
	public GeneratedGui(ZeusGuiContext context) : base(context) {}

	public override void Setup()
	{
		BLGeneratorUI ui = new BLGeneratorUI(MyMeta);
		ui.ShowDialog();
		input["Data"] = ui.Data;
		input["TargetPath"] = ui.TargetPath;
		input["FunctionGenInfoData"] = ui.FunctionGenInfoData;
	}
	
}
##|GUI_END
##|BODY_MODE Markup
##|BODY_ENGINE .Net Script
##|BODY_LANGUAGE C#
##|BODY_TAG_START <%
##|BODY_TAG_END %>
##|BODY_BEGIN
<%#REFERENCE ZESABLGeneratorUI.dll%><% 

using System.Text;
using System.IO;
using System.Collections.Generic;
using EHA.ZESA.Util.GeneratorUI;

public class GeneratedTemplate : DotNetScriptTemplate
{
	private const string MANDANT       = "MANDANT";
	private const string BUCHUNGSKREIS = "BUCHUNGSKREIS";
	private const string KENNUNG       = "KENNUNG";
	private const string FUNKTION	   = "FUNKTION";
	private const string VERSION_NUM   = "VERSION_NUM";

	public GeneratedTemplate(ZeusContext context) : base(context) {}

	public override void Render()
	{
		//System.Diagnostics.Debugger.Launch();
		
		IColumns cols = null;
		IColumns primaryKeys = null;
		string entityname = string.Empty;
		string entitynameUpper = string.Empty;
		Dictionary<string,string> dbReaderDatatypeColumns;
		Dictionary<string,string> dbReaderOperatorColumns;
		FunctionGenInfo functionGenInfo;
				
		if(input["Data"] == null)
		{
			output.writeln("Cancelled by user ... ");
			return;
		}
		ArrayList data = input["Data"] as ArrayList;
		ArrayList functionGenInfoData = input["FunctionGenInfoData"] as ArrayList;
			
		// Dateiname bilden
		string filepathInProject = "Configuration\\Allgemein\\Database\\";
		string filepath = input["TargetPath"].ToString();
		if (!filepath.EndsWith("\\") ) filepath += "\\";
		string filePathProjectFile = filepath + "ZESAConfiguration\\ZESAConfiguration\\ZESAConfiguration.csproj";
		filepath += "ZESAConfiguration\\ZESAConfiguration\\Configuration\\Allgemein\\Database\\";
		
		
		// Verzeichnis bei Bedarf anlegen
		if(!Directory.Exists(filepath))
		{
			Directory.CreateDirectory(filepath);
		}
		
		// wir gehen jede GenInfo durch
		foreach(GenInfo info in data)
		{
			// übersteuernde Kriterien aufbauen
			dbReaderDatatypeColumns = GeneratorHelper.GetDbReaderDatatypeColumns(info);
			dbReaderOperatorColumns = GeneratorHelper.GetDbReaderOperatorColumns(info);
			functionGenInfo = null;
			cols = null;
			primaryKeys = null;
			entityname = string.Empty;
			entitynameUpper = string.Empty;
			bool hasVersionNum = false;
			
			// Differenzen zwischen ITable und IView eliminieren
			if(info.ObjectType == "Table")
			{
				ITable table = MyMeta.DefaultDatabase.Tables[info.ObjectName];
				cols = table.Columns;
				primaryKeys = table.PrimaryKeys;
				entityname = GeneratorHelper.ConvertName(info.EntityName);
				entitynameUpper = info.EntityName;
				// prüft ob eine Versionsnummer vorhanden ist.
				hasVersionNum = CheckForVersionNumColumn(cols);
			}
			else if(info.ObjectType == "View")
			{
				IView view = MyMeta.DefaultDatabase.Views[info.ObjectName];
				cols = view.Columns;
				primaryKeys = null;
				entityname = GeneratorHelper.ConvertName(info.ObjectName);
				entitynameUpper = info.ObjectName;
				// prüft ob eine Versionsnummer vorhanden ist.
				hasVersionNum = CheckForVersionNumColumn(cols);
			}
			else if(info.ObjectType == "Function")
			{
				entityname = GeneratorHelper.ConvertName(info.ObjectName);
				entitynameUpper = info.ObjectName;
				foreach(FunctionGenInfo funcInfo in functionGenInfoData)
				{
					if(funcInfo.FunctionName == info.ObjectName)
					{
						functionGenInfo = funcInfo;
					}
				}
				// prüft ob eine Versionsnummer vorhanden ist.
				hasVersionNum = CheckForVersionNumColumn(functionGenInfo);
			}
			
			// wir bilden unseren Dateinamen
			string filename  = filepath + info.ObjectName + ".config";
			string fileNameInProject = filepathInProject + info.ObjectName + ".config";
			
			// Markierung für geschützten Bereich in Source festlegen
			output.setPreserveSource(filename, "<!--####", "####-->");
			
			// File ausschecken
			try
			{
				TfsHelper.Instance.CheckOut(filename);
			}
			catch(Exception e)
			{
				output.writeln("Error: " + e.ToString());
				return;
			}
			
%><?xml version="1.0" encoding="utf-8" ?>
<configuration>
<DbReader>
<%
						
			// Geschützten Bereich aus altem Source übernehmen
			output.preserve("DbReader");
%>
<DataAccess>
<Queries>
<!-- <%=info.ObjectName%> - Beginn der Definition -->
<%OutputQueryHeadString( info, entityname, cols, functionGenInfo);%>
<Attributelists>
<Attributelist ID="$ATTLIST"></Attributelist>
</Attributelists>
<Attributes> 
<%
OutputAttributes(info.ObjectName, cols, dbReaderDatatypeColumns, functionGenInfo); 
%></Attributes>
<Parameterlists>
<%OutputParameterLists(cols, functionGenInfo);
%></Parameterlists>
<Parameters>
<%
OutputParameters(info.ObjectName, cols, dbReaderDatatypeColumns, dbReaderOperatorColumns, functionGenInfo); 
%></Parameters>
</Query>
<!-- <%=info.ObjectName%> - Ende der Definition -->
</Queries>
</DataAccess>
</DbReader>
<%
			// DbWriter Einträge werden nur für Tabellen generiert
			if(info.ObjectType == "Table")
			{
				// Geschützten Bereich aus altem Source übernehmen
				output.preserve("DbWriter");
				
				string sqlDataAdapter = BuildSql(cols, primaryKeys);
				if(string.IsNullOrEmpty(sqlDataAdapter))
					return;
%>
<DbWriter>
<DataAdapters>
<!-- <%=info.ObjectName%> - Beginn der Definition -->
<DataAdapter ID="<%=entityname%>">
<SourceTable><%=info.ObjectName%></SourceTable>
<Sql><%=sqlDataAdapter%></Sql>
<Parameters>
<%
	// Prüfung auf Integer PK, neue Logik
	if(info.IsPrimaryKeyInteger)
		{
%>	<Parameter Name="@ID" Type="LONG"></Parameter> <%} 
else {%>
	<Parameter Name="@ID" Type="GUID"></Parameter> <%}%>
</Parameters>
</DataAdapter>
</DataAdapters>
<%if(!hasVersionNum){%>
<SqlCommands>
<!-- <%=info.ObjectName%> - Beginn der Definition -->
<SqlCommand ID="Delete<%=entityname%>">
<SourceTable><%=info.ObjectName%></SourceTable>
<Sql>delete from <%=info.ObjectName%> where <%=primaryKeys[0].Name%> = @ID</Sql>
<Parameters>
<%
	// Prüfung auf Integer PK, neue Logik
	if(info.IsPrimaryKeyInteger)
		{
%>	<Parameter Name="@ID" Type="LONG"></Parameter> <%} 
else {%>
	<Parameter Name="@ID" Type="GUID"></Parameter> <%}%>
</Parameters>
</SqlCommand>
</SqlCommands><%}%>
</DbWriter>
<%
			}
%></configuration>
<%
		// neue Dateien der Projektdatei hinzufügen
		bool addToProject = false;
		if(!File.Exists(filename))
			addToProject = true;
		
		// Datei speichern
		output.save(filename, false);
		output.clear();
		
		// neue Dateien der Projektdatei hinzufügen
		if(addToProject)
		{
			// Projektdatei auschecken
			TfsHelper.Instance.CheckOut(filePathProjectFile);
			GeneratorHelper.AddFileToProject(Project.Configuration, fileNameInProject);
			TfsHelper.Instance.Add(filename);
		}
		
		// Logging
		output.writeln("Generierung " + entitynameUpper + ".config erfolgreich beendet...");
		output.writeln("");
		output.writeln("Ausgabeverzeichnis = " + filename);
		output.writeln("");
		string logname = input["TargetPath"].ToString();
		if (!logname.EndsWith("\\") ) logname += "\\";
		logname += "ZESA_Generierung_" + DateTime.Now.ToString("yyyyMMdd") + ".log";
		output.append(logname);
		MyMeta.SaveUserMetaData();
		output.clear();
		} // Ende foreach Geninfo
	}

	// Gibt alle Spalten der Tabelle als <Attribute> aus
	// Beispiel:
	// <Attribute ID="Mandant" ColName="BA_BENUTZER.MANDANT" DataType="NUM" AttribList="$ATTLIST"></Attribute>
	private void OutputAttributes(string pObjectName, IColumns pColumns, Dictionary<string,string> pDbReaderDatatypeCols, FunctionGenInfo pFunctionGenInfo)
	{
		if(null != pColumns)
		{
			int oldTabLevel = output.tabLevel;
			output.tabLevel = 1;
			int maxLength = GeneratorHelper.MaxColLength(pColumns);
			foreach(Column col in pColumns)
			{
				output.autoTab("<Attribute ID=\"");
				output.write(GeneratorHelper.ConvertName(col.Name));
				output.write("\"" + GeneratorHelper.FillUp(col.Name, maxLength));
				output.write(" ColName=\"");
				output.write(pObjectName + "." + col.Name);
				output.write("\"" + GeneratorHelper.FillUp(col.Name, maxLength));
				output.write(" DataType=");
				OutputDataType(pDbReaderDatatypeCols, col);
				output.writeln(" AttribList=\"$ATTLIST\"></Attribute>");
			}
			output.tabLevel = oldTabLevel;
		}
		else if(null != pFunctionGenInfo)
		{
			int oldTabLevel = output.tabLevel;
			output.tabLevel = 1;
			int maxLength = GeneratorHelper.MaxColLength(pFunctionGenInfo);
			foreach(TvfColumnInfo col in pFunctionGenInfo.FunctionReturnValueColumns)
			{
				output.autoTab("<Attribute ID=\"");
				output.write(GeneratorHelper.ConvertName(col.Name));
				output.write("\"" + GeneratorHelper.FillUp(col.Name, maxLength));
				output.write(" ColName=\"");
				output.write(pObjectName + "." + col.Name);
				output.write("\"" + GeneratorHelper.FillUp(col.Name, maxLength));
				output.write(" DataType=");
				OutputDataType(pDbReaderDatatypeCols, col);
				output.writeln(" AttribList=\"$ATTLIST\"></Attribute>");
			}
			output.tabLevel = oldTabLevel;
		}
	}
	
	// Gibt die Liste von Parameterlists aus.
	// Dieses sind auf jeden Fall $PARALIST1 und $PARALIST2.
	// Gibt es Spalten für die Sichtbarkeitsgruppe bzw. ext. Datengruppe, so werden auch $PARA_SG1 und $PARA_SG2 ausgegeben.
	private void OutputParameterLists( IColumns pColumns, FunctionGenInfo pFunctionGenInfo)
	{
		if(null != pColumns)
		{
			int oldTabLevel = output.tabLevel;
			output.tabLevel = 1;
			
			// $PARALIST1 und $PARALIST2 ausgeben.
			output.autoTabLn( "<Parameterlist ID=\"$PARALIST1\" Type=\"WHERE-CLAUSE\" Code=\"where \" InnerCode=\" and \"></Parameterlist>");
			output.autoTabLn( "<Parameterlist ID=\"$PARALIST2\" Type=\"WHERE-CLAUSE\" Code=\"or \" InnerCode=\" and \"></Parameterlist>");
			
			// In Abhängigkeit vom Vorhandensein von Sichtbarkeitsgruppe_Id bzw. Ext_Datengruppe_Id, $PARA_SG1 bzw. $PARA_SG2 ausgeben.
			// Anmerkung: Die Reihenfolge der IF-Statements ist relevant.
			bool hasSichtbarkeitsColumn = HasSichtbarkeitsColumn( pColumns);
			bool hasExtDatengruppeColumn = HasExtDatengruppeColumn( pColumns);
			if (hasSichtbarkeitsColumn || hasExtDatengruppeColumn)
			{
				output.autoTabLn( "<Parameterlist ID=\"$PARA_SG\" Type=\"WHERE-CLAUSE\" Code=\"and \" InnerCode=\" or \"></Parameterlist>");
			}

			// Abschließend noch die $ORDERLIST ausgeben.
			output.autoTabLn( "<Parameterlist ID=\"$ORDERLIST\" Type=\"BY-CLAUSE\" Code=\"order by \" InnerCode=\", \"></Parameterlist>");
			output.tabLevel = oldTabLevel;
		}
		else if(null != pFunctionGenInfo)
		{
			int oldTabLevel = output.tabLevel;
			output.tabLevel = 1;
			
			// $PARALIST1 und $PARALIST2 ausgeben.
			output.autoTabLn( "<Parameterlist ID=\"$PARALIST0\" Type=\"FUNCTION-PARAMS\" Code=\"\" InnerCode=\"\"></Parameterlist>");
			output.autoTabLn( "<Parameterlist ID=\"$PARALIST1\" Type=\"WHERE-CLAUSE\" Code=\"where \" InnerCode=\" and \"></Parameterlist>");
			output.autoTabLn( "<Parameterlist ID=\"$PARALIST2\" Type=\"WHERE-CLAUSE\" Code=\"or \" InnerCode=\" and \"></Parameterlist>");
			
			// In Abhängigkeit vom Vorhandensein von Sichtbarkeitsgruppe_Id bzw. Ext_Datengruppe_Id, $PARA_SG1 bzw. $PARA_SG2 ausgeben.
			// Anmerkung: Die Reihenfolge der IF-Statements ist relevant.
			bool hasSichtbarkeitsColumn = HasSichtbarkeitsColumn(pFunctionGenInfo);
			bool hasExtDatengruppeColumn = HasExtDatengruppeColumn(pFunctionGenInfo);
			if (hasSichtbarkeitsColumn || hasExtDatengruppeColumn)
			{
				output.autoTabLn( "<Parameterlist ID=\"$PARA_SG\" Type=\"WHERE-CLAUSE\" Code=\"and \" InnerCode=\" or \"></Parameterlist>");
			}

			// Abschließend noch die $ORDERLIST ausgeben.
			output.autoTabLn( "<Parameterlist ID=\"$ORDERLIST\" Type=\"BY-CLAUSE\" Code=\"order by \" InnerCode=\", \"></Parameterlist>");
			output.tabLevel = oldTabLevel;
		}
	}

	// Gibt alle Spalten der Tabelle als Parameter-Attribut aus
	// Für numerische Parameter werden zwei Parameter für von-/bis-Wert erzeugt
	// Beispiel:
	// <Parameter ID="Mandant"     ColName="BA_BENUTZER.MANDANT" DataType="NUM" ParaList="$PARALIST1" Operator="="></Parameter>
	// <Parameter ID="Von_Mandant" ColName="BA_BENUTZER.MANDANT" DataType="NUM" ParaList="$PARALIST1" Operator="&gt;="></Parameter>
	// <Parameter ID="Bis_Mandant" ColName="BA_BENUTZER.MANDANT" DataType="NUM" ParaList="$PARALIST1" Operator="&lt;="></Parameter>
	private void OutputParameters(string pObjectName, IColumns pColumns, Dictionary<string,string> pDbReaderDatatypeCols, Dictionary<string,string> pDbReaderOperatorCols, FunctionGenInfo pFunctionGenInfo)
	{
		if(null != pColumns)
		{
			int oldTabLevel = output.tabLevel;
			output.tabLevel = 1;
			int maxLength = GeneratorHelper.MaxColLength(pColumns);
			foreach(Column col in pColumns)
			{
				output.autoTab("<Parameter ID=\"");
				output.write(GeneratorHelper.ConvertName(col.Name));
				// +4 wg Von_ / Bis_
				output.write("\"" + GeneratorHelper.FillUp(col.Name, maxLength + 4));
				output.write(" ColName=\"");
				output.write(pObjectName + "." + col.Name);
				output.write("\"" + GeneratorHelper.FillUp(col.Name, maxLength));
				output.write(" DataType=");
				OutputDataType(pDbReaderDatatypeCols, col);
				output.writeln(" ParaList=\"" + GetParaList(col) + "\" Operator=\"" + GetOperator(pDbReaderOperatorCols, col) + "\"></Parameter>");
							
				if(GeneratorHelper.IsNumeric(col, pDbReaderDatatypeCols))
				{
					OutputNumericParameter(pObjectName, col, maxLength, pDbReaderDatatypeCols);
				}
			}
			output.tabLevel = oldTabLevel;
		}
		else if(null != pFunctionGenInfo)
		{
			int oldTabLevel = output.tabLevel;
			output.tabLevel = 1;
			int maxLength = GeneratorHelper.MaxColLength(pFunctionGenInfo);
			
			foreach(TvfColumnInfo col in pFunctionGenInfo.FunctionInputParameterColumns)
			{
				output.autoTab("<Parameter ID=\"");
				output.write(col.Name);
				// +4 wg Von_ / Bis_
				output.write("\"" + GeneratorHelper.FillUp(col.Name, maxLength + 4));
				output.write(" ColName=\"");
				output.write(GetColumnNameForFunctionInputParameter(col));
				output.write("\"" + GeneratorHelper.FillUp(GetColumnNameForFunctionInputParameter(col), maxLength + pObjectName.Length + 1));
				output.write(" DataType=");
				OutputDataType(pDbReaderDatatypeCols, col);
				output.writeln(" ParaList=\"$PARALIST0\" Operator=\"" + GetOperator(pDbReaderOperatorCols, col) + "\"></Parameter>");
			}
			
			foreach(TvfColumnInfo col in pFunctionGenInfo.FunctionReturnValueColumns)
			{
				output.autoTab("<Parameter ID=\"");
				output.write(GeneratorHelper.ConvertName(col.Name));
				// +4 wg Von_ / Bis_
				output.write("\"" + GeneratorHelper.FillUp(col.Name, maxLength + 4));
				output.write(" ColName=\"");
				output.write(pObjectName + "." + col.Name);
				output.write("\"" + GeneratorHelper.FillUp(col.Name, maxLength));
				output.write(" DataType=");
				OutputDataType(pDbReaderDatatypeCols, col);
				output.writeln(" ParaList=\"" + GetParaList(col) + "\" Operator=\"" + GetOperator(pDbReaderOperatorCols, col) + "\"></Parameter>");
							
				if(GeneratorHelper.IsNumeric(col, pDbReaderDatatypeCols))
				{
					OutputNumericParameter(pObjectName, col, maxLength, pDbReaderDatatypeCols);
				}
			}
			output.tabLevel = oldTabLevel;
		}
	}
	
	// Liefert die Art der Parameterliste: PARALIST1 im Normalfall sowie PARA_SG1 oder PARA_SG2 für Sichtbarkeits- und ext. Datengruppen-Spalten.
	private string GetParaList( IColumn pCol)
	{
		if (IsSichtbarkeitsColumn( pCol.Name) || IsExtDatengruppeColumn( pCol.Name))
			return "$PARA_SG";
		return "$PARALIST1";
	}
	
	// Liefert die Art der Parameterliste: PARALIST1 im Normalfall sowie PARA_SG1 oder PARA_SG2 für Sichtbarkeits- und ext. Datengruppen-Spalten
	// PARALIST2 für ERROR Spalten
	private string GetParaList( TvfColumnInfo pCol)
	{
		string retValue = "$PARALIST1";
		if (IsSichtbarkeitsColumn( pCol.Name) || IsExtDatengruppeColumn( pCol.Name))
		{
			retValue = "$PARA_SG";
		}
		else if(pCol.Name.ToUpper().Equals("ERROR"))
		{
			retValue = "$PARALIST2";
		}
		return retValue;
	}
	
	// Gibt eine numerische Spalte als Parameter-Attribut aus (Von_ / Bis_ Parameter)
	private void OutputNumericParameter(string pObjectName, IColumn pCol, int pMaxLength, Dictionary<string,string> pDbReaderDatatypeCols)
	{
			output.autoTab("<Parameter ID=\"Von_");
			output.write(GeneratorHelper.ConvertName(pCol.Name));
			output.write("\"" + GeneratorHelper.FillUp("Von_" + pCol.Name, pMaxLength + 4));
			output.write(" ColName=\"");
			output.write(pObjectName + "." + pCol.Name);
			output.write("\"" + GeneratorHelper.FillUp(pCol.Name, pMaxLength));
			output.write(" DataType=");
			OutputDataType(pDbReaderDatatypeCols, pCol);
			output.writeln(" ParaList=\"$PARALIST1\" Operator=\"&gt;=\"></Parameter>");
			output.autoTab("<Parameter ID=\"Bis_");
			output.write(GeneratorHelper.ConvertName(pCol.Name));
			output.write("\"" + GeneratorHelper.FillUp("Bis_" + pCol.Name, pMaxLength + 4));
			output.write(" ColName=\"");
			output.write(pObjectName + "." + pCol.Name);
			output.write("\"" + GeneratorHelper.FillUp(pCol.Name, pMaxLength));
			output.write(" DataType=");
			OutputDataType(pDbReaderDatatypeCols, pCol);
			output.writeln(" ParaList=\"$PARALIST1\" Operator=\"&lt;=\"></Parameter>");
	}
	
	// Gibt eine numerische Spalte als Parameter-Attribut aus (Von_ / Bis_ Parameter)
	private void OutputNumericParameter(string pObjectName, TvfColumnInfo pCol, int pMaxLength, Dictionary<string,string> pDbReaderDatatypeCols)
	{
			output.autoTab("<Parameter ID=\"Von_");
			output.write(GeneratorHelper.ConvertName(pCol.Name));
			output.write("\"" + GeneratorHelper.FillUp("Von_" + pCol.Name, pMaxLength + 4));
			output.write(" ColName=\"");
			output.write(pObjectName + "." + pCol.Name);
			output.write("\"" + GeneratorHelper.FillUp(pCol.Name, pMaxLength));
			output.write(" DataType=");
			OutputDataType(pDbReaderDatatypeCols, pCol);
			output.writeln(" ParaList=\"" + GetParaList(pCol) + "\" Operator=\"&gt;=\"></Parameter>");
			output.autoTab("<Parameter ID=\"Bis_");
			output.write(GeneratorHelper.ConvertName(pCol.Name));
			output.write("\"" + GeneratorHelper.FillUp("Bis_" + pCol.Name, pMaxLength + 4));
			output.write(" ColName=\"");
			output.write(pObjectName + "." + pCol.Name);
			output.write("\"" + GeneratorHelper.FillUp(pCol.Name, pMaxLength));
			output.write(" DataType=");
			OutputDataType(pDbReaderDatatypeCols, pCol);
			output.writeln(" ParaList=\"" + GetParaList(pCol) + "\" Operator=\"&lt;=\"></Parameter>");
	}

	// Gibt den Datentyp einer Spalte aus
	private void OutputDataType(Dictionary<string,string> pDbReaderDatatypeCols, IColumn pCol)
	{
		// LanguageType auslesen
		string temp = pCol.LanguageType.ToLower();
		
		// wenn es sich um einen PK handelt, dann geben wir long aus
		if(pCol.IsInPrimaryKey)
			temp = "guid";
		
		// übersteuernde Informatioenn auswerten und setzen
		if(pDbReaderDatatypeCols.ContainsKey(pCol.Name.ToUpper()))
			temp = pDbReaderDatatypeCols[pCol.Name.ToUpper()].ToLower();
		
		// mappen	
		if(temp == "guid")          output.write("\"GUID\"");
		else if(temp == "decimal")  output.write("\"CURL\" ");
		else if(temp == "long")     output.write("\"LONG\" ");
		else if(temp == "double")   output.write("\"NUM\" ");
		else if(temp == "int")      output.write("\"NUM\" ");
		else if(temp == "float")    output.write("\"SING\" ");
		else if(temp == "short")    output.write("\"NUM\" ");
		else if(temp == "byte")     output.write("\"NUM\" ");
		else if(temp == "datetime") output.write("\"DAT\" ");
		else if(temp == "bool")     output.write("\"BOOL\"");
		else if(temp == "byte[]")   output.write("\"BIN\" ");
		else                        output.write("\"TXT\" ");
	}

	// Gibt den Datentyp einer Spalte aus
	private void OutputDataType(Dictionary<string,string> pDbReaderDatatypeCols, TvfColumnInfo pColFunction)
	{
		// LanguageType auslesen
		string temp = pColFunction.LanguageType.ToLower();

		// übersteuernde Informatioenn auswerten und setzen
		if(pDbReaderDatatypeCols.ContainsKey(pColFunction.Name.ToUpper()))
			temp = pDbReaderDatatypeCols[pColFunction.Name.ToUpper()].ToLower();
		
		// mappen	
		if(temp == "guid")            output.write("\"GUID\"");
		else if(temp == "decimal")    output.write("\"CURL\" ");
		else if(temp == "long")       output.write("\"LONG\" ");
		else if(temp == "double")     output.write("\"NUM\" ");
		else if(temp == "int")        output.write("\"NUM\" ");
		else if(temp == "bit")        output.write("\"NUM\" ");
		else if(temp == "smallint")   output.write("\"NUM\" ");
		else if(temp == "tinyint") output.write("\"NUM\" ");
		else if(temp == "float")      output.write("\"SING\" ");
		else if(temp == "short")      output.write("\"NUM\" ");
		else if(temp == "byte")       output.write("\"NUM\" ");
		else if(temp == "datetime")   output.write("\"DAT\" ");
		else if(temp == "bool")       output.write("\"BOOL\"");
		else if(temp == "byte[]")     output.write("\"BIN\" ");
		else if(temp == "table")        output.write("\"TAB\" ");
		else                          output.write("\"TXT\" ");
	}

	// Gibt den Operator ( = oder like ) für eine Spalte zurück
	private string GetOperator(Dictionary<string,string> pDbReaderOperatorCols, IColumn pCol)
	{
		// prüfe auf Übersteuerung
		if(pDbReaderOperatorCols.ContainsKey(pCol.Name.ToUpper()))
			return pDbReaderOperatorCols[pCol.Name.ToUpper()];
				
		// Prüfe auf Ist-Gleich
		if(CheckForEqualColumn(pCol))
			return "=";
		
		string temp = pCol.LanguageType.ToLower();
		if(temp == "guid")          return "=";
		else if(temp == "datetime") return "=";
		else if(temp == "bool")     return "=";
		else if(temp == "decimal")  return "=";
		else if(temp == "long")     return "=";
		else if(temp == "double")   return "=";
		else if(temp == "int")      return "=";
		else if(temp == "float")    return "=";
		else if(temp == "short")    return "=";
		else if(temp == "byte")     return "=";
		else                        return "like";
	}
	
	// Gibt den Operator ( = oder like ) für eine Spalte zurück
	private string GetOperator(Dictionary<string,string> pDbReaderOperatorCols, TvfColumnInfo pCol)
	{
		// prüfe auf Übersteuerung
		if(pDbReaderOperatorCols.ContainsKey(pCol.Name.ToUpper()))
			return pDbReaderOperatorCols[pCol.Name.ToUpper()];
		
		// für die Fehlerbehnadlung bei Funktionen ist es wichtig,
		// dass die ERROR Spalte mit != abgefragt wird!
		if(pCol.Name.ToUpper().Equals("ERROR"))
		return "!=";

		// Prüfe auf Ist-Gleich
		if(CheckForEqualColumn(pCol))
			return "=";
		
		string temp = pCol.LanguageType.ToLower();
		if(temp == "guid")          return "=";
		else if(temp == "datetime") return "=";
		else if(temp == "bool")     return "=";
		else if(temp == "decimal")  return "=";
		else if(temp == "long")     return "=";
		else if(temp == "double")   return "=";
		else if(temp == "int")      return "=";
		else if(temp == "smallint") return "=";
		else if(temp == "tinyint")  return "=";
		else if(temp == "float")    return "=";
		else if(temp == "short")    return "=";
		else if(temp == "byte")     return "=";
		else if(temp == "table")    return "";
		else                        return "like";
	}
	
	// Prüft auf Spalten, die auf jeden Fall mit "=" abgefragt werden sollen.
	// Das sind: Mandant, Buchungskreis, sowie alle, die 'Kennung' im Namen beinhalten.
	// Aktuell wird hier auch auf 'Funktion' getestet. Der Grund liegt darin, dass
	// der Berechtigungsmanager derzeit noch nicht die Kennungen aus BA_FUNKTION auswertet,
	// sondern eben die Funktion. Ist das geaendert, kann der Eintrag hier heraus.
	private bool CheckForEqualColumn(IColumn pCol)
	{
		if(pCol.Name.ToUpper().Equals(MANDANT) ||
		   pCol.Name.ToUpper().Equals(BUCHUNGSKREIS) ||
		   pCol.Name.ToUpper().Equals(FUNKTION) ||
		   (pCol.Name.ToUpper().IndexOf(KENNUNG) >= 0))
		{
			return true;
		}
		return false;
	}
	
	// Prüft auf Spalten, die auf jeden Fall mit "=" abgefragt werden sollen.
	// Das sind: Mandant, Buchungskreis, sowie alle, die 'Kennung' im Namen beinhalten.
	// Aktuell wird hier auch auf 'Funktion' getestet. Der Grund liegt darin, dass
	// der Berechtigungsmanager derzeit noch nicht die Kennungen aus BA_FUNKTION auswertet,
	// sondern eben die Funktion. Ist das geaendert, kann der Eintrag hier heraus.
	private bool CheckForEqualColumn(TvfColumnInfo pCol)
	{
		if(pCol.Name.ToUpper().Equals(MANDANT) ||
		   pCol.Name.ToUpper().Equals(BUCHUNGSKREIS) ||
		   pCol.Name.ToUpper().Equals(FUNKTION) ||
		   (pCol.Name.ToUpper().IndexOf(KENNUNG) >= 0))
		{
			return true;
		}
		return false;
	}
	
	private bool IsSichtbarkeitsColumn(string pColName)
	{
		// Anmerkung: Dieser Test würde auch greifen für den Primärschlüssel einer potenziellen Tabelle BA_SICHTBARKEITSGRUPPE.
		if (pColName.ToUpper() == "SICHTBARKEITSGRUPPE_ID")
			return true;
		return false;
	}
	
	private bool HasSichtbarkeitsColumn(IColumns pColumns)
	{
		foreach(Column col in pColumns)
		{
			if (IsSichtbarkeitsColumn(col.Name))
				return true;
		}
		return false;
	}
	
	private bool HasSichtbarkeitsColumn(FunctionGenInfo pFunctionGenInfo)
	{
		foreach(TvfColumnInfo col in pFunctionGenInfo.FunctionReturnValueColumns)
		{
			if (IsSichtbarkeitsColumn(col.Name))
				return true;
		}
		return false;
	}
	
	private bool IsExtDatengruppeColumn(string pColName)
	{
		// Anmerkung: Dieser Test würde auch greifen für den Primärschlüssel einer potenziellen Tabelle BA_EXT_DATENGRUPPE.
		if (pColName.ToUpper() == "EXT_DATENGRUPPE_ID")
			return true;
		return false;
	}
	
	private bool HasExtDatengruppeColumn( IColumns pColumns)
	{
		foreach(Column col in pColumns)
		{
			if (IsExtDatengruppeColumn(col.Name))
				return true;
		}
		return false;
	}
	
	private bool HasExtDatengruppeColumn(FunctionGenInfo pFunctionGenInfo)
	{
		foreach(TvfColumnInfo col in pFunctionGenInfo.FunctionReturnValueColumns)
		{
			if (IsExtDatengruppeColumn(col.Name))
				return true;
		}
		return false;
	}
	
	private string CreateSichtbarkeitsQueryString(IColumns pColumns)
	{
		string ret = string.Empty;
		bool hasSichtbarkeitsColumn = HasSichtbarkeitsColumn(pColumns);
		bool hasExtDatengruppeColumn = HasExtDatengruppeColumn(pColumns);
		if (hasSichtbarkeitsColumn || hasExtDatengruppeColumn)
			ret = " $PARA_SG";
		
		return ret;
	}
	
	private string CreateSichtbarkeitsQueryString(FunctionGenInfo pFunctionGenInfo)
	{
		string ret = string.Empty;
		bool hasSichtbarkeitsColumn = HasSichtbarkeitsColumn(pFunctionGenInfo);
		bool hasExtDatengruppeColumn = HasExtDatengruppeColumn(pFunctionGenInfo);
		if (hasSichtbarkeitsColumn || hasExtDatengruppeColumn)
			ret = " $PARA_SG";
		
		return ret;
	}
	
	// Erzeugt die initiale "<Query ... />" Zeile.
	private void OutputQueryHeadString( GenInfo pInfo, string pEntityname, IColumns pColumns, FunctionGenInfo pFunctionGenInfo)
	{
		if(null != pColumns)
		{
			// Tables / Views
			string outString = "<Query ID=\"" + pEntityname + "_List\" Name=\"" + pEntityname + "_List\" Statement=\"Select $ATTLIST from " + pInfo.ObjectName + " $PARALIST1 $PARALIST2";
			outString += CreateSichtbarkeitsQueryString(pColumns);
			outString += " $ORDERLIST\" DifferentApplicationMaxRecordsUsed=\"\" DifferentDataPageSizeUsed=\"\" Type=\"SQL\">";
			output.autoTab( outString);
		}
		else if (null != pFunctionGenInfo)
		{
			// Functions
			string outString = "<Query ID=\"" + pEntityname + "_List\" Name=\"" + pEntityname + "_List\" Statement=\"Select $ATTLIST from " + pInfo.ObjectName + " ($PARALIST0) $PARALIST1 $PARALIST2";
			outString += CreateSichtbarkeitsQueryString(pFunctionGenInfo);
			outString += " $ORDERLIST\" DifferentApplicationMaxRecordsUsed=\"\" DifferentDataPageSizeUsed=\"\" Type=\"SQL\">";
			output.autoTab( outString);
		}
	}
	
	// SQL-String für DbWriter erzeugen
	private string BuildSql(IColumns pCols, IColumns pPrimaryKeys)
	{
		if(null == pPrimaryKeys)
		{
			output.writeln("Error: Kein Primary Key übergeben!");
			return string.Empty;;
		}
		
		string table = pCols[0].Table.Name;
		StringBuilder sql = new StringBuilder("select ");
		for(int i = 0; i < pCols.Count; i++)
		{
			sql.Append(table + "." + pCols[i].Name);
			if(i < (pCols.Count - 1))
			{
				sql.Append(", ");
			}
		}
		sql.Append(" from " + table);
		sql.Append(" where " + pPrimaryKeys[0].Name);
		sql.Append(" = @ID");
		return sql.ToString();
	}
	
	// Prüfen, ob Tabelle Spalte VERSION_NUM enthält
	private bool CheckForVersionNumColumn(IColumns pCols)
	{
		if(null == pCols)
			return false;
		
		foreach(IColumn col in pCols)
		{
			if(col.Name.ToUpper() == VERSION_NUM)
			{
				return true;
			}
		}
		return false;
	}
	
	// Prüfen, ob Tabelle Spalte VERSION_NUM enthält
	private bool CheckForVersionNumColumn(FunctionGenInfo pFunctionGenInfo)
	{
		if(null == pFunctionGenInfo)
			return false;
		
		foreach(TvfColumnInfo col in pFunctionGenInfo.FunctionReturnValueColumns)
		{
			if(col.Name.ToUpper() == VERSION_NUM)
				return true;
		}
		return false;
	}
	
	// gibt den ColumnName für Funktionsparameter zurück
	private string GetColumnNameForFunctionInputParameter(TvfColumnInfo pColInfo)
	{
		string retValue = pColInfo.Name;
		if(null != pColInfo)
		{
			if(pColInfo.LanguageType.ToLower().Equals("table"))
				retValue = "TT_SEL_ID";
		}
		return retValue;
	}
}
