		// Prüfen, ob Tabelle die übergebene Spalte enthält
		private bool CheckForColumn(IColumns pCols, string pColumnToUpper)
		{
			foreach(IColumn col in pCols)
			{
				if(col.Name.ToUpper() == pColumnToUpper)
				{
					return true;
				}
			}
			return false;
		}
		
		// gibt alle Verwendeten Usings zurück
		private ArrayList GetUsings()
		{
			ArrayList retValue = new ArrayList();
			retValue.Add("System");
			retValue.Add("System.Collections");
			retValue.Add("System.Data");
			retValue.Add("System.Data.SqlClient");
			retValue.Add("System.Diagnostics");
			retValue.Add("System.Linq");
			retValue.Add("System.Text");
			retValue.Add("System.Threading");
			retValue.Add("EHA.ZESA.Communication.RemotingServiceInterface.Allgemein");
			retValue.Add("EHA.ZESA.Communication.RemotingServiceInterface.Allgemein.ClientContext");
			retValue.Add("EHA.ZESA.Communication.RemotingServiceInterface.DAO.Basis.Konfiguration");
			retValue.Add("EHA.ZESA.Communication.RemotingServiceInterface.DAO.Basis.Buchungskreis");
			retValue.Add("EHA.ZESA.Communication.RemotingServiceInterface.DAO.Basis.Mandant");
			retValue.Add("EHA.ZESA.Server.BusinessFacade.Allgemein");
			retValue.Add("EHA.ZESA.Server.BusinessFacade.Basis");
			return retValue;
		}
		
		// Ermittelt die AliasKennung für eine Tabelle
		private string GetKennungColumnForTable(ArrayList pStammdatenuebernahmeInfoList, string pTableName)
		{
			foreach(StammdatenuebernahmeInfo sInfo in pStammdatenuebernahmeInfoList)
			{
				string objectNamePkTable = GeneratorHelper.ConvertName(sInfo.ObjectName);
				if(objectNamePkTable.ToLower().Equals(pTableName.ToLower()))
					return GeneratorHelper.ConvertName(sInfo.AliasKennungColumn);
			}
			
			// nichts gefunden? nichts zurückgeben
			return string.Empty;
		}
}

	
