        <Query ID="V_Vertragspartner_List" Name="V_Vertragspartner_List" Statement="Select $ATTLIST from V_VERTRAGSPARTNER $PARALIST1 $PARALIST2 $ORDERLIST" DifferentApplicationMaxRecordsUsed="" DifferentDataPageSizeUsed="" Type="SQL">
          <Attributelists>
            <Attributelist ID="$ATTLIST"></Attributelist>
