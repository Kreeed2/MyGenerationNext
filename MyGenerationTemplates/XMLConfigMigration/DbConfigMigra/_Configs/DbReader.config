        <Query ID="V_Rolle_Rollendetail_List" Name="V_Rolle_Rollendetail_List" Statement="Select $ATTLIST from V_ROLLE_ROLLENDETAIL $PARALIST1 $PARALIST2 $ORDERLIST" DifferentApplicationMaxRecordsUsed="" DifferentDataPageSizeUsed="" Type="SQL">
