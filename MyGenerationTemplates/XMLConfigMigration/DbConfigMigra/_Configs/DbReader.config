        <!-- Stammdatenexport - Anpassung, um generierte offene Positionen mit auszugeben - Beginn der Definition 
             ACHTUNG : MANUELL ANGEPASST, wird von V_STAMMDATENEXPORT_ANLAGE_VERTRAG_BILANZIERUNGSGEBIET benutzt.
              Vtartkennung ParaList="$PARALIST2" Operator="like"
              Vtbereichkennung Operator="like"
              Vttypkennung Operator="like"
              Vtkontotypkennung Operator="like"
              Vtkontostatuskennung Operator="like"
              Vtkontostatuskennungforopo ParaList="$PARALIST2" Operator="like"
              Anlageidforopo ParaList="$PARALIST2"
              Int_Vertragskontonummer Operator="like"
        -->
        <Query ID="V_Stammdatenexport_Anlage_Vertrag_Incl_Opo_List" Name="V_Stammdatenexport_Anlage_Vertrag_Incl_Opo_List" Statement="Select $ATTLIST from V_STAMMDATENEXPORT_ANLAGE_VERTRAG $PARALIST1 $PARALIST2 $ORDERLIST" DifferentApplicationMaxRecordsUsed="" DifferentDataPageSizeUsed="" Type="SQL">
          <Attributelists>
            <Attributelist ID="$ATTLIST"></Attributelist>
          </Attributelists>
          <Attributes>
            <Attribute ID="Vertragskonto_Id"                    ColName="V_STAMMDATENEXPORT_ANLAGE_VERTRAG.VERTRAGSKONTO_ID"                    DataType="GUID" AttribList="$ATTLIST"></Attribute>
            <Attribute ID="Anlage_Id"                           ColName="V_STAMMDATENEXPORT_ANLAGE_VERTRAG.ANLAGE_ID"                           DataType="GUID" AttribList="$ATTLIST"></Attribute>
            <Attribute ID="Kontierungsobjekt"                   ColName="V_STAMMDATENEXPORT_ANLAGE_VERTRAG.KONTIERUNGSOBJEKT"                   DataType="TXT"  AttribList="$ATTLIST"></Attribute>
            <Attribute ID="Vertragsart"                         ColName="V_STAMMDATENEXPORT_ANLAGE_VERTRAG.VERTRAGSART"                         DataType="TXT"  AttribList="$ATTLIST"></Attribute>
            <Attribute ID="Laufzeit_Ab"                         ColName="V_STAMMDATENEXPORT_ANLAGE_VERTRAG.LAUFZEIT_AB"                         DataType="DAT"  AttribList="$ATTLIST"></Attribute>
            <Attribute ID="Laufzeit_Bis"                        ColName="V_STAMMDATENEXPORT_ANLAGE_VERTRAG.LAUFZEIT_BIS"                        DataType="DAT"  AttribList="$ATTLIST"></Attribute>
