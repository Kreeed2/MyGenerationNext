            <Attribute ID="Int_Geschaeftsbeziehung_Nr"  ColName="V_VERTRAGSPARTNER.INT_GESCHAEFTSBEZIEHUNG_NR"  DataType="NUM"  AttribList="$ATTLIST"></Attribute>
