						<Attribute ID="Gueltig_Von"      ColName="VT_HI_MSB_GERAET.GUELTIG_VON"      DataType="DAT"  AttribList="$ATTLIST"></Attribute>
						<Attribute ID="Gueltig_Bis"      ColName="VT_HI_MSB_GERAET.GUELTIG_BIS"      DataType="DAT"  AttribList="$ATTLIST"></Attribute>
						<Attribute ID="Preis"            ColName="VT_HI_MSB_GERAET.PREIS"            DataType="NUM"  AttribList="$ATTLIST"></Attribute>
						<Attribute ID="Insdate"          ColName="VT_HI_MSB_GERAET.INSDATE"          DataType="DAT"  AttribList="$ATTLIST"></Attribute>
