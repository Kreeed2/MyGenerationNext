        <Query ID="V_Vertrag_Suche_Wizard_List" Name="V_Vertrag_Suche_Wizard_List" Statement="Select $ATTLIST from V_VERTRAG_SUCHE_WIZARD $PARALIST1 $PARALIST2 $PARA_SG $ORDERLIST" DifferentApplicationMaxRecordsUsed="" DifferentDataPageSizeUsed="" Type="SQL">
