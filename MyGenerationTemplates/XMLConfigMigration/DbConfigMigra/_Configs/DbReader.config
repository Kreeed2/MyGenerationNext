            <Attribute ID="Beschreibung"    ColName="V_ROLLE_ROLLENDETAIL.BESCHREIBUNG"    DataType="TXT"  AttribList="$ATTLIST"></Attribute>
            <Attribute ID="Kennung"         ColName="V_ROLLE_ROLLENDETAIL.KENNUNG"         DataType="TXT"  AttribList="$ATTLIST"></Attribute>
