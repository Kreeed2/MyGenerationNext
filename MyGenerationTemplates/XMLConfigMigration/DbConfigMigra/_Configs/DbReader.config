            <Attribute ID="Upddate"         ColName="V_ROLLE_ROLLENDETAIL.UPDDATE"         DataType="DAT"  AttribList="$ATTLIST"></Attribute>
            <Attribute ID="Upduser"         ColName="V_ROLLE_ROLLENDETAIL.UPDUSER"         DataType="TXT"  AttribList="$ATTLIST"></Attribute>
            <Attribute ID="Geloescht"       ColName="V_ROLLE_ROLLENDETAIL.GELOESCHT"       DataType="BOOL" AttribList="$ATTLIST"></Attribute>
            <Attribute ID="Rolle_Id"        ColName="V_ROLLE_ROLLENDETAIL.ROLLE_ID"        DataType="GUID" AttribList="$ATTLIST"></Attribute>
            <Attribute ID="Rolle"           ColName="V_ROLLE_ROLLENDETAIL.ROLLE"           DataType="TXT"  AttribList="$ATTLIST"></Attribute>
