            <Attribute ID="Int_Geschaeftsbeziehung_Nr" ColName="V_VERTRAG_SUCHE_WIZARD.INT_GESCHAEFTSBEZIEHUNG_NR" DataType="NUM"  AttribList="$ATTLIST"></Attribute>
