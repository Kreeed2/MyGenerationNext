				<Query ID="Hi_Msb_Geraet_List" Name="Hi_Msb_Geraet_List" Statement="Select $ATTLIST from VT_HI_MSB_GERAET $PARALIST1 $PARALIST2 $ORDERLIST" DifferentApplicationMaxRecordsUsed="" DifferentDataPageSizeUsed="" Type="SQL">
					<Attributelists>
						<Attributelist ID="$ATTLIST"></Attributelist>
					</Attributelists>
					<Attributes> 
						<Attribute ID="Hi_Msb_Geraet_Id" ColName="VT_HI_MSB_GERAET.HI_MSB_GERAET_ID" DataType="GUID" AttribList="$ATTLIST"></Attribute>
