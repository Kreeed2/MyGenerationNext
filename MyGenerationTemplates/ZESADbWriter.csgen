##|TYPE Template
##|UNIQUEID 0c706303-e609-46e9-bcc5-d30a4a81c0be
##|TITLE ZESADbWriter
##|NAMESPACE 
##|SOURCE_TYPE Source
##|OUTPUT_LANGUAGE None
##|GUI_ENGINE .Net Script
##|GUI_LANGUAGE C#
##|GUI_BEGIN
<%#REFERENCE ZESABLGeneratorUI.dll, System.Windows.Forms.dll %>
<%#NAMESPACE System, System.Text, System.Collections, System.Windows.Forms, Zeus, Zeus.UserInterface, Zeus.Templates.DotNetScript, EHA.ZESA.Util.GeneratorUI %>

public class GeneratedGui : DotNetScriptGui
{
	public GeneratedGui(ZeusGuiContext context) : base(context) {}

	public override void Setup()
	{
		BLGeneratorUI ui = new BLGeneratorUI(MyMeta);
		ui.ShowDialog();
		input["Data"] = ui.Data;
		input["TargetPath"] = ui.TargetPath;
	}
	
}
##|GUI_END
##|BODY_MODE Markup
##|BODY_ENGINE .Net Script
##|BODY_LANGUAGE C#
##|BODY_TAG_START <%
##|BODY_TAG_END %>
##|BODY_BEGIN
<%#REFERENCE ZESABLGeneratorUI.dll %><%
using System.Text;
using System.IO;
using EHA.ZESA.Util.GeneratorUI;

public class GeneratedTemplate : DotNetScriptTemplate
{
	public GeneratedTemplate(ZeusContext context) : base(context) {}

  public override void Render()
	{
		IColumns cols;
		IColumns primaryKeys;
		string entityname;
		string entitynameUpper;
			
	  if(input["Data"] == null)
		{
			output.writeln("Cancelled by user ... ");
			return;
		}
		ArrayList data = input["Data"] as ArrayList;
		string filepath;
	
		// Dateinamen erzeugen
		filepath = input["TargetPath"].ToString();
		if (!filepath.EndsWith("\\") ) filepath += "\\";
		
		// Verzeichnis bei Bedarf anlegen
		if(!Directory.Exists(filepath))
		{
			Directory.CreateDirectory(filepath);
		}
		string filename  = filepath + "DbWriter.config";
		
		// File ausschecken
		TfsHelper.Instance.CheckOut(filename);

		// Markierung für geschützten Bereich in Source definieren
		output.setPreserveSource(filename, "<!--####", "####-->");
%><?xml version="1.0" encoding="utf-8" ?>
<application>
	<configuration>
		<DbWriter>
			<Connection type="SqlClient" encrypted="false" connectstring="Persist Security Info=False;Initial Catalog=ZESA_ENTW;Data Source=HEW01EHA05\SQL2005;User ID=ZESA_TEST;Password=zesatest"></Connection>
			<alternativeConfig IsActive="false" ConfigDirectory="Database"> </alternativeConfig>
			<DataAdapters>
<%
		// Geschützten Bereich für die DataAdapter aus altem Source übernehmen
		output.preserve("Individuelle_Data_Adapter");
		// Einträge für INSERT / UPDATE erzeugen
		foreach(GenInfo info in data)
		{
			// Nur auf Tabellen kann schreibend zugegriffen werden
			if(info.ObjectType == "Table")
			{
				ITable table = MyMeta.DefaultDatabase.Tables[info.ObjectName];
				cols = table.Columns;
				primaryKeys = table.PrimaryKeys;
				entityname = GeneratorHelper.ConvertName(info.EntityName);
				entitynameUpper = info.EntityName;
%>
<!-- <%=info.ObjectName%> - Beginn der Definition -->
				<DataAdapter ID="<%=entityname%>">
					<SourceTable><%=info.ObjectName%></SourceTable>
					<Sql><%=BuildSql(cols, primaryKeys)%></Sql>
					<Parameters>
						<Parameter Name="@ID" Type="GUID"></Parameter>
					</Parameters>
				</DataAdapter>
<%
			}
		}
%>
			</DataAdapters>
			
			<SqlCommands>
<%
		// Einträge für DELETE erzeugen
		foreach(GenInfo info in data)
		{
			if(info.ObjectType == "Table")
			{
				ITable table = MyMeta.DefaultDatabase.Tables[info.ObjectName];
				cols = table.Columns;
				primaryKeys = table.PrimaryKeys;
				entityname = GeneratorHelper.ConvertName(info.EntityName);
				entitynameUpper = info.EntityName;
%>
<!-- <%=info.ObjectName%> - Beginn der Definition -->
				<SqlCommand ID="Delete<%=entityname%>">
					<Sql>delete from <%=info.ObjectName%> where <%=primaryKeys[0].Name%> = @ID</Sql>
					<Parameters>
						<Parameter Name="@ID" Type="GUID"></Parameter>
					</Parameters>
				</SqlCommand>
<%
			}
		}
		
		// Geschützten Bereich für die SqlCommands (DELETE) aus altem Source übernehmen
		output.preserve("Individuelle SqlCommands");
%>
			</SqlCommands>
		</DbWriter>
	</configuration>
</application>
<%
		output.save(filename, false);
		output.clear();
		
		// Logging
		output.writeln("Generierung DbWriter.config erfolgreich beendet...");
		output.writeln("");
		output.writeln("Ausgabeverzeichnis = " + filename);
		output.writeln("");
		string logname = input["TargetPath"].ToString();
		if (!logname.EndsWith("\\") ) logname += "\\";
		logname += "ZESA_Generierung_" + DateTime.Now.ToString("yyyyMMdd") + ".log";
		output.append(logname);
		MyMeta.SaveUserMetaData();
		output.clear();
	}

	// SQL-String erzeugen
	private string BuildSql(IColumns pCols, IColumns pPrimaryKeys)
	{
		string table = pCols[0].Table.Name;
		StringBuilder sql = new StringBuilder("select ");
		for(int i = 0; i < pCols.Count; i++)
		{
			sql.Append(table + "." + pCols[i].Name);
			if(i < (pCols.Count - 1))
			{
				sql.Append(", ");
			}
		}
		sql.Append(" from " + table);
		sql.Append(" where " + pPrimaryKeys[0].Name);
		sql.Append(" = @ID");
		return sql.ToString();
	}
}
%>
##|BODY_END
