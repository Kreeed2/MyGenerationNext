		#endregion Initialisierung

		#region Property-Methoden 
		#endregion Property-Methoden

		#region Öffentliche Methoden

		/// <summary>
		/// Liest eine Liste aller vorhandenen Datensätze der Tabelle <%=info.ObjectName%>.
		/// </summary>
		/// <param name="pContext">Der aktuelle <see cref="ClientContext" />.</param>
		/// <returns>Eine <see cref="<%=entityname%>DAO"/>-Instanz mit den gelesenen Daten.</returns>
		/// <exception cref="ClientErrorException">Wird geworfen, wenn die Daten nicht gelesen werden konnten.</exception>
		/// <remarks>Die Ergebnismenge ist auf den im <see cref="ClientContext" /> übergebenen Mandant und Buchungskreis eingeschränkt.</remarks>
		public <%=entityname%>DAO GetList(ClientContext pContext)
		{
			try
			{
				return new <%=BuildClassname(entityname)%>().GetList(pContext);
			}
			catch(Exception e)
			{
				base.HandleException(e);
				return null;
			}
		}

