<%}%>
		/// <summary>
		/// Aktualisiert die übergebenen Datensätze in der Tabelle <%=info.ObjectName%>.
		/// </summary>
		/// <param name="pContext">Der aktuelle <see cref="ClientContext" />.</param>
		/// <param name="pData">Eine <see cref="<%=entityname%>DAO"/>-Instanz mit den zu aktualisierenden Daten.</param>
		/// <returns>Die Anzahl der geschriebenen Datensätze.</returns>
		/// <exception cref="ClientErrorException">Wird geworfen, wenn der Update fehlgeschlagen ist.</exception>
		/// <remarks>
		/// Die Methode führt sowohl Updates als auch Inserts in der Datenbank aus. Das übergebene
		/// DataSet darf durchaus mehrere Datensätze enthalten. Die Struktur des DataSets muss der
		/// Tabellenstruktur entsprechen.
		/// </remarks>
		public int Update(ClientContext pContext, <%=entityname%>DAO pData)
		{

			mLog.Debug("Update<%=entityname%> for " + pContext.ToString());
<% if(!hasVersionNum){ %>
			// Standardvalidierung von der BusinessLogic erledigen lassen.
			try
			{
				new <%=BuildClassname(entityname)%>().Validate<%=entityname%>Fields( pContext, pData);
			}
			catch (ValidationException e)
			{
				// Hier im (generierten) Server können wir nur Annahmen über den Client anstellen.
				// Wir nehmen an, dass das UserControl, welches dem Datenbankfeld zugeordnet ist,
				// den gleichen Namen wie dieses mit vorangestelltem "txt" trägt.
				e.FieldInfo = "txt" + e.DbFieldInfo;

				// Jetzt verabschieden wir uns aus dem DB-Schreibprozess und geben die Kontrolle zurück an den Client.
				throw e;
			}
<%}%>
			Guid transactionId = Guid.Empty;
			int result;

			try
			{	<%if(info.Stammdatenuebernahme) { %>
				// bevor wir die Transaktion öffnen prüfen wir ob der User Berechtigt ist Stammdatenpflege zu betreiben
			    bool userHasStammdatenpflegePermission = true;
				if(ConfigValues.Instance.PruefeStammdatenAenderungsBerechtigung(pContext))
				{
                    string[] user = pContext.BenutzerName.Split('_');
                    if (!user[0].ToLower().StartsWith("admin") && !user[0].ToLower().StartsWith("geplanterjob"))
                        userHasStammdatenpflegePermission = new BerechtigungsManager().BenutzerIsInFunktionsgruppeByKennung(pContext, KennungDefinitions.BA_FUNKTIONSGRUPPE_STAMMDATENPFLEGE);
				} <%}%> 
				transactionId = DbWriter.Instance.GetTransaction();
				result = new <%=BuildClassname(entityname)%>().Update(pContext, pData, transactionId);
				if(result > 0)
				{
					<%if(info.Stammdatenuebernahme) { %> // keine Berechtigung? Rollback und Exception werfen
                    if (!userHasStammdatenpflegePermission)
                    {
                        DbWriter.Instance.RollbackTransaction(transactionId);
                        throw new StammdatenpflegeNotAllowedException();
                    }<%}%> 
					DbWriter.Instance.CommitTransaction(transactionId);
				}
				else
				{
					mLog.Info("Update<%=entityname%> für Kontext " + pContext.ToString() + " hat keine Daten aktualisiert");
					DbWriter.Instance.RollbackTransaction(transactionId);
				}
			}
			catch(DbWriterException e)
			{
				try
				{
					DbWriter.Instance.RollbackTransaction(transactionId);
				}
				catch(DbWriterException e1)
				{
					mLog.Error("Rollback für Update<%=entityname%> für Kontext <" + pContext.ToString() + " ist fehlgeschlagen", e1);
					throw ClientExceptionHelper.Instance.TranslateException("UPDATE_DATA_FAILED", ErrorLevel.Error, e1);
				}
				mLog.Error("Update<%=entityname%> für Kontext <" + pContext.ToString() + " ist fehlgeschlagen", e);
				throw ClientExceptionHelper.Instance.TranslateException("UPDATE_DATA_FAILED", ErrorLevel.Error, e);
			}
			catch(Exception e)
			{
				<%if(info.Stammdatenuebernahme) { %> 
				if (e is StammdatenpflegeNotAllowedException)
				{
					// Berechtigungsprobleme werfen wir weiter
					throw ClientExceptionHelper.Instance.TranslateException("STAMMDATENAENDERUNG_NOT_ALLOWED", ErrorLevel.Validate);
				}
				else
				{
					// andernfalls einen unerwarteten Fehler melden...
					throw ClientExceptionHelper.Instance.TranslateException("UNEXPECTED_ERROR", ErrorLevel.Error, e);
				}
				<%} else { %> throw ClientExceptionHelper.Instance.TranslateException("UNEXPECTED_ERROR", ErrorLevel.Error, e); <%}%> 
			}
			return result;
		}

<%if (info.UsesOldDataSetLogic){
%>		/// <summary>
		/// Aktualisiert die übergebenen Datensätze in der Tabelle <%=info.ObjectName%>.
		/// </summary>
		/// <param name="pContext">Der aktuelle <see cref="ClientContext" />.</param>
		/// <param name="pData">Eine <see cref="DataSet"/>-Instanz mit den zu aktualisierenden Daten.</param>
		/// <returns>Die Anzahl der geschriebenen Datensätze.</returns>
		/// <exception cref="ClientErrorException">Wird geworfen, wenn der Update fehlgeschlagen ist.</exception>
		/// <remarks>
		/// Die Methode führt sowohl Updates als auch Inserts in der Datenbank aus. Das übergebene
		/// DataSet darf durchaus mehrere Datensätze enthalten. Die Struktur des DataSets muss der
		/// Tabellenstruktur entsprechen.
		/// </remarks>
		public int Update<%=entityname%>(ClientContext pContext, DataSet pData)
		{

			mLog.Debug("Update<%=entityname%> for " + pContext.ToString());
<% if(!hasVersionNum){ %>
			// Standardvalidierung von der BusinessLogic erledigen lassen.
			try
			{
				new <%=BuildClassname(entityname)%>().Validate<%=entityname%>Fields( pContext, pData);
			}
			catch (ValidationException e)
			{
				// Hier im (generierten) Server können wir nur Annahmen über den Client anstellen.
				// Wir nehmen an, dass das UserControl, welches dem Datenbankfeld zugeordnet ist,
				// den gleichen Namen wie dieses mit vorangestelltem "txt" trägt.
				e.FieldInfo = "txt" + e.DbFieldInfo;

				// Jetzt verabschieden wir uns aus dem DB-Schreibprozess und geben die Kontrolle zurück an den Client.
				throw e;
			}
<%}%>			
			Guid transactionId = Guid.Empty;
			int result;

			try
			{
				<%if(info.Stammdatenuebernahme) { %>
				// bevor wir die Transaktion öffnen prüfen wir ob der User Berechtigt ist Stammdatenpflege zu betreiben
			    bool userHasStammdatenpflegePermission = true;
				if(ConfigValues.Instance.PruefeStammdatenAenderungsBerechtigung(pContext))
				{
                    string[] user = pContext.BenutzerName.Split('_');
                    if (!user[0].ToLower().StartsWith("admin") && !user[0].ToLower().StartsWith("geplanterjob"))
                        userHasStammdatenpflegePermission = new BerechtigungsManager().BenutzerIsInFunktionsgruppeByKennung(pContext, KennungDefinitions.BA_FUNKTIONSGRUPPE_STAMMDATENPFLEGE);
				} <%}%> 
				transactionId = DbWriter.Instance.GetTransaction();
				result = new <%=BuildClassname(entityname)%>().Update<%=entityname%>(pContext, pData, transactionId);
				if(result > 0)
				{
					<%if(info.Stammdatenuebernahme) { %> // keine Berechtigung? Rollback und Exception werfen
                    if (!userHasStammdatenpflegePermission)
                    {
                        DbWriter.Instance.RollbackTransaction(transactionId);
                        throw new StammdatenpflegeNotAllowedException();
                    }<%}%> 
					DbWriter.Instance.CommitTransaction(transactionId);
				}
				else
				{
					mLog.Info("Update<%=entityname%> für Kontext " + pContext.ToString() + " hat keine Daten aktualisiert");
					DbWriter.Instance.RollbackTransaction(transactionId);
				}
			}
			catch(DbWriterException e)
			{
				try
				{
					DbWriter.Instance.RollbackTransaction(transactionId);
				}
				catch(DbWriterException e1)
				{
					mLog.Error("Rollback für Update<%=entityname%> für Kontext <" + pContext.ToString() + " ist fehlgeschlagen", e1);
					throw ClientExceptionHelper.Instance.TranslateException("UPDATE_DATA_FAILED", ErrorLevel.Error, e1);
				}
				mLog.Error("Update<%=entityname%> für Kontext <" + pContext.ToString() + " ist fehlgeschlagen", e);
				throw ClientExceptionHelper.Instance.TranslateException("UPDATE_DATA_FAILED", ErrorLevel.Error, e);
			}
			catch(Exception e)
			{
				<%if(info.Stammdatenuebernahme) { %> 
				if (e is StammdatenpflegeNotAllowedException)
				{
					// Berechtigungsprobleme werfen wir weiter
					throw ClientExceptionHelper.Instance.TranslateException("STAMMDATENAENDERUNG_NOT_ALLOWED", ErrorLevel.Validate);
				}
				else
				{
					// andernfalls einen unerwarteten Fehler melden...
					throw ClientExceptionHelper.Instance.TranslateException("UNEXPECTED_ERROR", ErrorLevel.Error, e);
				}
				<%} else { %> throw ClientExceptionHelper.Instance.TranslateException("UNEXPECTED_ERROR", ErrorLevel.Error, e); <%}%> 
			}
			return result;
		}
<%}%>
		/// <summary>
		/// Löscht einen Datensatz aus der Tabelle <%=info.ObjectName%>.
		/// </summary>
		/// <param name="pContext">Der aktuelle <see cref="ClientContext" />.</param>
		/// <param name="pPrimaryKey">Der Primärschlüssel des zu Löschenden Datensatzes.</param>
		/// <returns>Die Anzahl der gelöschten Sätze.</returns>
		/// <exception cref="DbWriterException">
		/// Wird geworfen, wenn beim Löschen ein Fehler auf dem Datenbankserver aufgetreten ist.
		/// </exception>
		/// <exception cref="ManagerException">
		/// Wird geworfen, wenn mehr als ein Datensatz gelöscht wurde.
		/// </exception>
		public int Delete<%=entityname%>(ClientContext pContext, string pPrimaryKey)
		{

			mLog.Debug("Delete<%=entityname%> für " + pContext.ToString());

			Guid transactionId = Guid.Empty;
			int result;

			try
			{
				<%if(info.Stammdatenuebernahme) { %>
				// bevor wir die Transaktion öffnen prüfen wir ob der User Berechtigt ist Stammdatenpflege zu betreiben
			    bool userHasStammdatenpflegePermission = true;
				if(ConfigValues.Instance.PruefeStammdatenAenderungsBerechtigung(pContext))
				{
                    string[] user = pContext.BenutzerName.Split('_');
                    if (!user[0].ToLower().StartsWith("admin") && !user[0].ToLower().StartsWith("geplanterjob"))
                        userHasStammdatenpflegePermission = new BerechtigungsManager().BenutzerIsInFunktionsgruppeByKennung(pContext, KennungDefinitions.BA_FUNKTIONSGRUPPE_STAMMDATENPFLEGE);
				} <%}%> 
				transactionId = DbWriter.Instance.GetTransaction();
				result = new <%=BuildClassname(entityname)%>().Delete(pContext, pPrimaryKey, transactionId);
				if(result > 1)
				{
					mLog.Error("Delete<%=entityname%> für Kontext " + pContext.ToString() + " hat mehr als einen Datensatz gelöscht.");
					DbWriter.Instance.RollbackTransaction(transactionId);
					throw ClientExceptionHelper.Instance.TranslateException("MANAGER_DELETE_MORE_THAN_ONE_RECORD", ErrorLevel.Error);
				}
				else if(result == 1)
				{
					<%if(info.Stammdatenuebernahme) { %> // keine Berechtigung? Rollback und Exception werfen
                    if (!userHasStammdatenpflegePermission)
                    {
                        DbWriter.Instance.RollbackTransaction(transactionId);
                        throw new StammdatenpflegeNotAllowedException();
                    }<%}%> 
					DbWriter.Instance.CommitTransaction(transactionId);
				}
				else
				{
					mLog.Info("Delete<%=entityname%> für Kontext " + pContext.ToString() + " hat keine Datensätze gelöscht.");
					DbWriter.Instance.RollbackTransaction(transactionId);
				}
			}
			catch(DbWriterException e)
			{
				try
				{
					DbWriter.Instance.RollbackTransaction(transactionId);
				}
				catch(DbWriterException e1)
				{
					mLog.Info("Rollback für Delete<%=entityname%> für Kontext " + pContext.ToString() + " ist fehlgeschlagen.", e1);
					throw ClientExceptionHelper.Instance.TranslateException("DELETE_DATA_FAILED", ErrorLevel.Error, e1);
				}
				mLog.Info("Delete<%=entityname%> für Kontext " + pContext.ToString() + " ist fehlgeschlagen.", e);
				throw ClientExceptionHelper.Instance.TranslateException("DELETE_DATA_FAILED", ErrorLevel.Error, e);
			}<%if(info.Stammdatenuebernahme) { %> 
			catch(StammdatenpflegeNotAllowedException)
			{
				// Berechtigungsprobleme werfen wir weiter
				throw ClientExceptionHelper.Instance.TranslateException("STAMMDATENAENDERUNG_NOT_ALLOWED", ErrorLevel.Validate);
			}<%}%>
			return result;
		}

<% if(hasVersionNum){ %>
		/// <summary>
		/// Löscht mehrere Datensätze aus der Tabelle <%=info.ObjectName%>.
		/// </summary>
		/// <param name="pContext">Der aktuelle <see cref="ClientContext" />.</param>
		/// <param name="pDao">ein Dao mit den zu löschenden Datensätzen.</param>
		/// <returns>Die Anzahl der gelöschten Sätze.</returns>
		/// <exception cref="DbWriterException">
		/// Wird geworfen, wenn beim Löschen ein Fehler auf dem Datenbankserver aufgetreten ist.
		/// </exception>
		public int Delete(ClientContext pContext, <%=entityname%>DAO pDao)
		{

			mLog.Debug("Delete<%=entityname%> für " + pContext.ToString());

			Guid transactionId = Guid.Empty;
			int result;

			try
			{
				<%if(info.Stammdatenuebernahme) { %>
				// bevor wir die Transaktion öffnen prüfen wir ob der User Berechtigt ist Stammdatenpflege zu betreiben
			    bool userHasStammdatenpflegePermission = true;
				if(ConfigValues.Instance.PruefeStammdatenAenderungsBerechtigung(pContext))
				{
                    string[] user = pContext.BenutzerName.Split('_');
                    if (!user[0].ToLower().StartsWith("admin") && !user[0].ToLower().StartsWith("geplanterjob"))
                        userHasStammdatenpflegePermission = new BerechtigungsManager().BenutzerIsInFunktionsgruppeByKennung(pContext, KennungDefinitions.BA_FUNKTIONSGRUPPE_STAMMDATENPFLEGE);
				} <%}%> 
				transactionId = DbWriter.Instance.GetTransaction();
				result = new <%=BuildClassname(entityname)%>().Delete(pContext, pDao, transactionId);
				
				if(result >= 1)
				{
					<%if(info.Stammdatenuebernahme) { %> // keine Berechtigung? Rollback und Exception werfen
                    if (!userHasStammdatenpflegePermission)
                    {
                        DbWriter.Instance.RollbackTransaction(transactionId);
                        throw new StammdatenpflegeNotAllowedException();
                    }<%}%> 
					DbWriter.Instance.CommitTransaction(transactionId);
				}
				else
				{
					mLog.Info("Delete<%=entityname%> für Kontext " + pContext.ToString() + " hat keine Datensätze gelöscht.");
					DbWriter.Instance.RollbackTransaction(transactionId);
				}
			}
			catch(DbWriterException e)
			{
				try
				{
					DbWriter.Instance.RollbackTransaction(transactionId);
				}
				catch(DbWriterException e1)
				{
					mLog.Info("Rollback für Delete<%=entityname%> für Kontext " + pContext.ToString() + " ist fehlgeschlagen.", e1);
					throw ClientExceptionHelper.Instance.TranslateException("DELETE_DATA_FAILED", ErrorLevel.Error, e1);
				}
				mLog.Info("Delete<%=entityname%> für Kontext " + pContext.ToString() + " ist fehlgeschlagen.", e);
				throw ClientExceptionHelper.Instance.TranslateException("DELETE_DATA_FAILED", ErrorLevel.Error, e);
			}<%if(info.Stammdatenuebernahme) { %> 
			catch(StammdatenpflegeNotAllowedException)
			{
				// Berechtigungsprobleme werfen wir weiter
				throw ClientExceptionHelper.Instance.TranslateException("STAMMDATENAENDERUNG_NOT_ALLOWED", ErrorLevel.Validate);
			}<%}%>
			return result;
		}
<%}%>
		#endregion Öffentliche Methoden

		#region private Methoden
		#endregion private Methoden
		
		#region individuelle Anpassungen
		
<%
		// geschützten Bereich aus altem Source übernehmen
		output.preserve("Individuelle_Anpassungen");
%>

		#endregion individuelle Anpassungen
	}
}
<%
				// neue Dateien der Projektdatei hinzufügen
				bool addToProject = false;
				if(!File.Exists(filename))
					addToProject = true;
			
				// Save File
				output.save(filename, false);
				output.clear();	
			
				// neue Dateien der Projektdatei hinzufügen
				if(addToProject)
				{
					// Projektdatei auschecken
					TfsHelper.Instance.CheckOut(filePathProjectFile);
					GeneratorHelper.AddFileToProject(Project.Server, fileNameInProject);
					TfsHelper.Instance.Add(filename);
				}		
			}
		}
		
		// Logging
		output.clear();
		output.writeln("Generierung Manager-Klassen erfolgreich beendet...");
		output.writeln("");
		output.writeln("Ausgabeverzeichnis = " + input["TargetPath"]);
		output.writeln("");
		output.writeln("Folgende Dateien wurden generiert:" );
		output.writeln("");
		foreach(string csFile in csFiles)
		{
		    output.writeln(csFile);
		}
		output.writeln("");
		output.writeln("==> Ende <==");
		output.writeln("");
		string logname = input["TargetPath"].ToString();
		if (!logname.EndsWith("\\") ) logname += "\\";
		logname += "ZESA_Generierung_" + DateTime.Now.ToString("yyyyMMdd") + ".log";
		output.append(logname);
    output.clear();	
		MyMeta.SaveUserMetaData();
	}
	
	// Für die Businesslogik-Klasse Vertrag muss der Namespace vorangestellt werden
	private string BuildClassname(string pEntityName)
	{
		if(pEntityName == "Vertrag")
			return "DAO.Vertrag.Vertrag";
		else
			return pEntityName;
	}
	
	// Prüfen, ob Tabelle Spalte VERSION_NUM enthält
	private bool CheckForVersionNumColumn(IColumns pCols)
	{
		foreach(IColumn col in pCols)
		{
			if(col.Name.ToUpper() == VERSION_NUM)
			{
				return true;
			}
		}
		return false;
	}
}
%>
