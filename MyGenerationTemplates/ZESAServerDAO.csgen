		/// <exception cref="InvalidParameterException">Wird geworfen, wenn ein ungültiger Parameters übergeben wurde.</exception>
		/// <exception cref="SetParameterFailedException">Wird geworfen, wenn der Parameter nicht gesetzt werden konnte.</exception>
		private static void SetDbParameterMandant(ClientContext pContext, string pQryResultId, <%=entityname%>Parameter pParams)
		{
			DbReaderHelper.Instance.SetDbParameter(pQryResultId, MANDANT, pParams.Mandant);
			DbReaderHelper.Instance.SetDbParameter(pQryResultId, VON_MANDANT, pParams.Von_Mandant);
			DbReaderHelper.Instance.SetDbParameter(pQryResultId, BIS_MANDANT, pParams.Bis_Mandant);

			// Standard-Mandant nur, wenn Von_Mandant / Bis_Mandant nicht als Parameter übergeben wurden
			if (null == pParams.Von_Mandant && null == pParams.Bis_Mandant)
			{
				DbReaderHelper.Instance.SetDbParameter(pQryResultId, MANDANT, pContext.Mandant);
			}
