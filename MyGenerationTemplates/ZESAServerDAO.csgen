<%if (info.Stammdatenuebernahme){ %>
		/// <summary>
        /// gibt die SQL Syntax für eine Query zurück
        /// </summary>
        /// <param name="pContext"></param>
        /// <param name="pParams"></param>
        /// <param name="pOrderList"></param>
        /// <returns></returns>
        public string GetQuerySQL(ClientContext pContext, <%=entityname%>DAO pParams, ArrayList pOrderList)
        {
            try
            {
                string qryResultId = DbReaderHelper.Instance.GetQueryId(pContext, QRY_LIST);

                SetDbParameters(qryResultId, pParams);
                SetDbParameterMandant(pContext, qryResultId, pParams);
                SetDbParameterBuchungskreis(pContext, qryResultId, pParams);

                if (null != pOrderList)
                {
                    DbReaderHelper.Instance.SetOrder(qryResultId, pOrderList);
                }
                // Syntax zurückgeben
                return DbReader.GetInstance().CheckQuerySyntax(qryResultId);
            }
            catch (ValidationException)
            {
                throw;
            }
            catch (BaseApplicationException e)
            {
                throw new ExecuteQueryFailedException(e);
            }
            catch (Exception e)
            {
                throw new BusinessLogicException(e);
            }
        }
		
		/// <summary>
        /// Wandelt ein DataSet in ein VerifiedDAO um.
        /// </summary>
        /// <param name="pData">Das DataSet mit den Daten</param>
        /// <returns>Ein VerifiedDAO</returns>
        public <%=entityname%>DAO BuildDAOFromDataSet(DataSet pData)
        {
		    CheckTableExists(pData, TableDataName);
            
            <%=entityname%>DAO dao = new <%=entityname%>DAO();
            dao.AddDataSet(pData);
            dao.SetCurrentRow(<%=entityname%>DAO.TBL_DATA, 0);
            return dao;
        }
		
<%} // Ende Code für Stammdatenübernahme%>
