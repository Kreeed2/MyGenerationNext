		/// <summary>
        /// Liefert ein leeres DAO, welches lediglich die zu Grunde liegende Struktur enthält, aber keinerlei Daten.
        /// Die aktuelle Zeile ist -1.
        /// </summary>
        /// <param name="pContext">Der aktuelle <see cref="ClientContext" />.</param>
        /// <exception cref="ExecuteQueryFailedException">Wird geworfen, wenn bei der Initialisierung oder Ausführung der Abfrage ein Fehler auftritt.</exception>
        /// <exception cref="BusinessLogicException">Wird geworfen, wenn eine nicht behandelte Exception auftritt</exception>
        /// <exception cref="DAODataSetNullException">Wird geworfen, wenn das gekapselte DataSet <c>null</c> ist.</exception>
        /// <exception cref="DAOInvalidTableNameException">Wird geworfen, wenn der übergebene Tabellen- / Viewname nicht im gekapselten DataSet existiert.</exception>
        /// <returns>Ein leeres DAO mit zu Grunde liegenden Strukturinformationen.</returns>
        /// <remarks>Das DAO ist leer. Bevor es für Datenbankoperationen (Update et cetera) verwendet werden kann, sind ihm Daten hinzuzufügen.</remarks>
