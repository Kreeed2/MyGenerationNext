		/// <summary>
		/// Liest eine Liste von ausgewählten Datensätzen der Tabelle <%=info.ObjectName%>
		/// ohne Begrenzung der zurückgelieferten Datensätze.
		/// </summary>
		/// <param name="pContext">Der aktuelle <see cref="ClientContext" />.</param>
		/// <param name="pParams">Eine <see cref="<%=entityname%>Parameter" />-Struktur mit den Parameterwerten.</param>
		/// <param name="pOrderList">Eine Liste von Spaltennamen, nach denen sortiert werden soll.</param>
		/// <param name="pTransactionId">Die Id der aktuell laufenden Transaktion</param>
		/// <returns>Eine Dataset-Instanz mit den gelesenen Daten.</returns>
		/// <exception cref="ExecuteQueryFailedException">Wird geworfen, wenn bei der Initialisierung oder Ausführung der Abfrage ein Fehler auftritt.</exception>
		/// <exception cref="BusinessLogicException">Wird geworfen, wenn eine nicht behandelte Exception auftritt</exception>
		/// <remarks>
		/// Die Ergebnismenge wird an Hand der in der Struktur <see cref="<%=entityname%>Parameter" /> angegebenen Werte eingeschränkt.
		/// Zusätzlich wird die Ergebnismenge ist auf den im <see cref="ClientContext" /> übergebenen Mandant und Buchungskreis eingeschränkt.
		/// Die Sortierung erfolgt immer aufsteigend nach den in der ArrayList übergebenen Spaltennamen.
		/// </remarks>
		public DataSet Get<%=entityname%>ByParamAll(ClientContext pContext, <%=entityname%>Parameter pParams, ArrayList pOrderList, Guid pTransactionId)
		{
			try
			{
				string qryResultId = DbReaderHelper.Instance.GetQueryId(pContext, QRY_LIST);
	
				SetDbParameters(qryResultId, pParams);
<%	if(hasMandant) 
		{
%>				SetDbParameterMandant(pContext, qryResultId, pParams);
<%	}
		if(hasBuchungskreis) 
		{
%>				SetDbParameterBuchungskreis(pContext, qryResultId, pParams);
<%	}
		if(isVertrag) 
		{
%>				SetDbParameterSichtbarkeit(pContext, qryResultId);
<%	}
		if(hasExtDatengruppe)
		{
%>				SetDbParameterExtDatengruppe( pContext, qryResultId);
		<%}%>
				if(null != pOrderList)
				{
					DbReaderHelper.Instance.SetOrder(qryResultId, pOrderList);
				}
	
				// im DBReader die Einstellung "ApplicationMaxRecords" auf "Unlimited" setzen
				// Datensatzbeschränkung wird damit temporär aufgehoben
				DbReaderHelper.Instance.SetQueryResultCount(qryResultId, Globals.GET_UNLIMITED_RECORDS);
				if (mLog.IsDebugEnabled)
				{
					string test = DbReader.GetInstance().CheckQuerySyntax(qryResultId);
					mLog.Debug("Get<%=entityname%>ByParam Sql for Context " + pContext + ": \n" + test);
				}
				DataSet data = DbReaderHelper.Instance.ReadData(pContext, qryResultId, pTransactionId);
				return data;
			}
			catch( ValidationException)
			{
				throw;
			}
			catch(BaseApplicationException e)
			{
				throw new ExecuteQueryFailedException(e);
			}
			catch(Exception e)
			{
				throw new BusinessLogicException(e);
			}
		}

