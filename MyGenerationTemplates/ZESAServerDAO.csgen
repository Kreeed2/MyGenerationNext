<%#REFERENCE ZESABLGeneratorUI.dll %><%
using System.Text;
using System.IO;
using System.Collections.Generic;
using EHA.ZESA.Util.GeneratorUI;
public class GeneratedTemplate : DotNetScriptTemplate
{
	private const string MANDANT       = "MANDANT";
	private const string BUCHUNGSKREIS = "BUCHUNGSKREIS";
	private const string SICHTBARKEIT  = "SICHTBARKEITSGRUPPE_ID";
	private const string EXT_DATENGRUPPE = "EXT_DATENGRUPPE_ID";
	private const string SORTIERUNG    = "SORTIERUNG";
	private const string GELOESCHT     = "GELOESCHT";
	private const string TYPE_TABLE    = "Table";
	private const string TABLE_NAME_HISTORIENBELEG = "HISTORIENBELEG";
	private const string VERSION_NUM = "VERSION_NUM";
	private const string UPDDATE = "UPDDATE";
	private const string INSDATE = "INSDATE";
	private const string INSUSER = "INSUSER";
	private const string UPDUSER = "UPDUSER";

	// Flag, welches gesetzt wird, wenn wenigstens eine NORMTIME-Spalte gefunden wurde. 
	// Hilft, Compilerwarnungen wg. ungenutzter Funktionen zu vermeiden.
	bool normtimeColumnFound = false;
	
	public GeneratedTemplate(ZeusContext context) : base(context) {}

	public override void Render()
	{
		if(input["Data"] == null)
		{
			output.writeln("Cancelled by user ... ");
			return;
		}
		ArrayList data = input["Data"] as ArrayList;
		ArrayList functionGenInfoData = input["FunctionGenInfoData"] as ArrayList;
		ArrayList csFiles = new ArrayList();
		string filepath;
		Dictionary<string,string> dbReaderDatatypeColumns;

		foreach(GenInfo info in data)
		{
			IColumns cols = null;
			string entityname = string.Empty;
			string entitynameUpper = string.Empty;
			FunctionGenInfo functionGenInfo = null;
			
			// übersteuernde Kriterien aufbauen
			dbReaderDatatypeColumns = GeneratorHelper.GetDbReaderDatatypeColumns(info);
			
			// Differenzen zwischen ITable und IView eliminieren
			if(TYPE_TABLE == info.ObjectType)
			{
				ITable table = MyMeta.DefaultDatabase.Tables[info.ObjectName];
				cols = table.Columns;
				entityname = GeneratorHelper.ConvertName(info.EntityName);
				entitynameUpper = info.EntityName;
			}
			else if(info.ObjectType == "View")

			{
				IView view = MyMeta.DefaultDatabase.Views[info.ObjectName];
				cols = view.Columns;
				entityname = GeneratorHelper.ConvertName(info.ObjectName);
				entitynameUpper = info.ObjectName;
			}
			else if(info.ObjectType == "Function")
			{
				entityname = GeneratorHelper.ConvertName(info.ObjectName);
				entitynameUpper = info.ObjectName;
				foreach(FunctionGenInfo funcInfo in functionGenInfoData)
				{
					if(funcInfo.FunctionName == info.ObjectName)
					{
						functionGenInfo = funcInfo;
					}
				}
			}

			// Prüfen, ob Tabelle die Spalten enthält, welche für die weitere Verarbeitung relevant sind.
			bool hasMandant       = CheckForMandantColumn(cols, functionGenInfo);
			bool hasBuchungskreis = CheckForBuchungskreisColumn(cols, functionGenInfo);
			bool isVertrag        = CheckForSichtbarkeitColumn(cols, functionGenInfo);
			bool hasExtDatengruppe = CheckForExtDatengruppeColumn(cols, functionGenInfo);
			bool hasSortierung		 = CheckForSortierungColumn(cols, functionGenInfo);
			bool hasGeloescht		 = CheckForGeloeschtColumn(cols, functionGenInfo);
			bool hasVersionNum		 = CheckForVersionNumColumn(cols, functionGenInfo);
						
			// Fuer den Historienbeleg wird (derzeit) nicht auf die Sichtbarkeitsgruppe eingeschraenkt.
			if(isVertrag && (TABLE_NAME_HISTORIENBELEG == entityname.ToUpper()))
			{
				isVertrag = false;
				hasExtDatengruppe = false;
			}
			
			// Klassennamen bilden
			string classname     = entityname;
			string fullClassname = "EHA.ZESA.Server.DAO." + info.Namespace + "." + classname;
			string fileNameInProject = "DAO\\" + info.Namespace + "\\" + classname + ".cs";
			
			// Dateinamen bilden
			filepath = input["TargetPath"].ToString();
			if (!filepath.EndsWith("\\") ) filepath += "\\";
			string filePathProjectFile = filepath + "Server\\ZESAServer\\ZESAServer.csproj";
			filepath += "Server\\ZESAServer\\DAO\\" + info.Namespace + "\\";
			
			// Verzeichnis bei Bedarf anlegen
			if(!Directory.Exists(filepath))
			{
				Directory.CreateDirectory(filepath);
			}
			string filename  = filepath + entityname + ".cs";
			
			// File ausschecken
			TfsHelper.Instance.CheckOut(filename);
			
			// Dateinamen für Logging zwischenspeichern
			csFiles.Add(fullClassname);
			
			// Markierung für geschützten Bereich im Source definieren
			output.setPreserveSource(filename, "/***", "***/");
%>using System;
using System.Collections;
using System.Data;
<%if(!hasVersionNum && TYPE_TABLE == info.ObjectType){%>using EHA.ZESA.Communication.RemotingServiceInterface.Allgemein;<%}%>
