	// Gibt alle Spalten der Tabelle als Attribute-Attribut aus
	// Beispiel:
	// public const string BENUTZER_ID = "Benutzer_Id";
	private void OutputAttributes(IColumns pColumns, Dictionary<string,string> pDbReaderDatatypeCols)
	{
		if (null != pColumns)
		{
			int oldTabLevel = output.tabLevel;
			output.tabLevel = 2;
			int maxLength = GeneratorHelper.MaxColLength(pColumns);
			foreach(Column col in pColumns)
			{
				if(col.Name.ToUpper() == MANDANT || col.Name.ToUpper() == BUCHUNGSKREIS || col.Name.ToUpper() == UPDDATE || col.Name.ToUpper() == INSDATE 
				|| col.Name.ToUpper() == INSUSER || col.Name.ToUpper() == UPDUSER || col.Name.ToUpper() == GELOESCHT || col.Name.ToUpper() == SICHTBARKEIT || col.Name.ToUpper() == EXT_DATENGRUPPE || col.Name.ToUpper() == VERSION_NUM)
				{
					continue;
				}
				output.autoTabLn("public const string " + col.Name.ToUpper() + GeneratorHelper.FillUp(col.Name, maxLength) + "     = \"" + GeneratorHelper.ConvertName(col.Name) + "\";");
				
				if(GeneratorHelper.IsNumeric(col, pDbReaderDatatypeCols))
				{
					output.autoTabLn("public const string VON_" + col.Name.ToUpper() + GeneratorHelper.FillUp(col.Name, maxLength) + " = \"Von_" + GeneratorHelper.ConvertName(col.Name) + "\";");
					output.autoTabLn("public const string BIS_" + col.Name.ToUpper() + GeneratorHelper.FillUp(col.Name, maxLength) + " = \"Bis_" + GeneratorHelper.ConvertName(col.Name) + "\";");
				}
			}
			output.tabLevel = oldTabLevel;
		}
	}
	
	// Gibt alle Spalten der Tabelle als Attribute-Attribut aus
	// Beispiel:
	// public const string BENUTZER_ID = "Benutzer_Id";
	private void OutputAttributes(FunctionGenInfo pFunctionGenInfo, Dictionary<string,string> pDbReaderDatatypeCols)
	{
		if (null != pFunctionGenInfo)
		{
			int oldTabLevel = output.tabLevel;
			output.tabLevel = 2;
			int maxLength = GeneratorHelper.MaxColLength(pFunctionGenInfo);
			foreach(TvfColumnInfo col in pFunctionGenInfo.FunctionReturnValueColumns)
			{
				if(col.Name.ToUpper() == MANDANT || col.Name.ToUpper() == BUCHUNGSKREIS || col.Name.ToUpper() == UPDDATE || col.Name.ToUpper() == INSDATE 
				|| col.Name.ToUpper() == INSUSER || col.Name.ToUpper() == UPDUSER || col.Name.ToUpper() == GELOESCHT || col.Name.ToUpper() == SICHTBARKEIT || col.Name.ToUpper() == EXT_DATENGRUPPE || col.Name.ToUpper() == VERSION_NUM)
				{
					continue;
				}
				output.autoTabLn("public const string " + col.Name.ToUpper() + GeneratorHelper.FillUp(col.Name, maxLength) + "     = \"" + GeneratorHelper.ConvertName(col.Name) + "\";");
				
				if(GeneratorHelper.IsNumeric(col, pDbReaderDatatypeCols))
				{
					output.autoTabLn("public const string VON_" + col.Name.ToUpper() + GeneratorHelper.FillUp(col.Name, maxLength) + " = \"Von_" + GeneratorHelper.ConvertName(col.Name) + "\";");
					output.autoTabLn("public const string BIS_" + col.Name.ToUpper() + GeneratorHelper.FillUp(col.Name, maxLength) + " = \"Bis_" + GeneratorHelper.ConvertName(col.Name) + "\";");
				}
			}
			output.tabLevel = oldTabLevel;
		}
	}

	// Ausgabe der Aufrufe SetDbParameter(...) für alle Spalten der Tabelle
	// Beispiel:
	// SetDbParameter(qryResultId, KonditionsartColDefs.MANDANT, pContext.Mandant);
	private void OutputDbParameter(IColumns pColumns, string pNormTimeToColumns, Dictionary<string,string> pDbReaderDatatypeCols, string pEntityname)
	{
		int oldTabLevel = output.tabLevel;
		output.tabLevel = 3;
		foreach(Column col in pColumns)
		{
			string colName = GeneratorHelper.ConvertName(col.Name);
			if(col.Name.Equals(GELOESCHT))
			{
				output.autoTabLn("if(!((null == pParams." + colName + ") || (pParams." + colName + ".Equals(string.Empty))))");
				output.autoTabLn("{");
				output.tabLevel = 4;
				output.autoTabLn("DbReaderHelper.Instance.SetDbParameter(qryResultId, " + col.Name.ToUpper() + ", pParams." + colName + ");");
				output.tabLevel = 3;
				output.autoTabLn("}");
				output.autoTabLn("else");
				output.autoTabLn("{");
				output.tabLevel = 4;
				output.autoTabLn("DbReaderHelper.Instance.SetDbParameter(qryResultId, " + col.Name.ToUpper() + ", \"0\");");
				output.tabLevel = 3;
				output.autoTabLn("}");
			}
			else
			{
				// Numerische Felder bekommen VON_ sowie BIS_ Parameter zusätzlich. Mandant und Buchungskreis sind ausgenommen, da diese nicht vom Nutzer eingegeben werden.
				if((GeneratorHelper.IsNumeric(col, pDbReaderDatatypeCols)) && (MANDANT != col.Name.ToUpper()) && (BUCHUNGSKREIS != col.Name.ToUpper()))
				{
					// Normalisierte Bis-Werte bekommen ihre Uhrzeit auf 23:59:00 gesetzt, damit die Suche nach genau so heraus geschriebenen Werten funktioniert.
					if(IsColumnInList(colName, pNormTimeToColumns))
					{
						normtimeColumnFound = true;
						output.autoTabLn("DbReaderHelper.Instance.SetDbParameter(qryResultId, VON_" + col.Name.ToUpper() + ", NormalizeDateTimeAsString( pParams.Von_" + colName + ", false));");
						output.autoTabLn("DbReaderHelper.Instance.SetDbParameter(qryResultId, BIS_" + col.Name.ToUpper() + ", NormalizeDateTimeAsString( pParams.Bis_" + colName + ", false));");
						output.autoTabLn("DbReaderHelper.Instance.SetDbParameter(qryResultId, " + col.Name.ToUpper() + ", NormalizeDateTimeAsString( pParams." + colName + ", false));");
					}
					// Numerische nicht-DateTime-Attribute bekommen zusätzliche Validierung, um fehlerhafte Suchparameter für '='-Anfragen auszuschließen.
					else
					{
						// Prüfung auf gültigen numerischen Wert nur für numerische Datentypen, nicht für DateTime durchführen.
						if (col.LanguageType.ToLower() != "datetime")
						{
							output.autoTabLn("try");
							output.autoTabLn("{");
							output.tabLevel = 4;
							output.autoTabLn("StandardValidator.ValidateNumericField( pParams.Von_" + colName + ");");
							output.autoTabLn("StandardValidator.ValidateNumericField( pParams.Bis_" + colName + ");");
							output.autoTabLn("StandardValidator.ValidateNumericField( pParams." + colName + ");");
							output.tabLevel = 3;
							output.autoTabLn("}");
							output.autoTabLn("catch( ValidationException e)");
							output.autoTabLn("{");
							output.tabLevel = 4;
							output.autoTabLn("e.DbFieldInfo = " + col.Name.ToUpper() + ";");
							output.autoTabLn("throw;");
							output.tabLevel = 3;
							output.autoTabLn("}");
							output.autoTabLn("catch( Exception e)");
							output.autoTabLn("{");
							output.tabLevel = 4;
							output.autoTabLn("throw new BusinessLogicException(\"UNEXPECTED_EXCEPTION\", e);");
							output.tabLevel = 3;
							output.autoTabLn("}");
						}
						output.autoTabLn("DbReaderHelper.Instance.SetDbParameter(qryResultId, VON_" + col.Name.ToUpper() + ", pParams.Von_" + colName + ");");
						output.autoTabLn("DbReaderHelper.Instance.SetDbParameter(qryResultId, BIS_" + col.Name.ToUpper() + ", pParams.Bis_" + colName + ");");
						output.autoTabLn("DbReaderHelper.Instance.SetDbParameter(qryResultId, " + col.Name.ToUpper() + ", pParams." + colName + ");");
					}
				}
				// Nichtnumerische Felder bekommen weder VON_ und BIS-Parameter, noch gesonderte Validierungen.
				else
				{
					// Normalisierte Bis-Werte bekommen ihre Uhrzeit auf 23:59:00 gesetzt, damit die Suche nach genau so heraus geschriebenen Werten funktioniert.
					if(IsColumnInList(colName, pNormTimeToColumns))
					{
						normtimeColumnFound = true;
						output.autoTabLn("DbReaderHelper.Instance.SetDbParameter(qryResultId, " + col.Name.ToUpper() + ", NormalizeDateTimeAsString( pParams." + colName + ", false));");
					}
					else
						output.autoTabLn("DbReaderHelper.Instance.SetDbParameter(qryResultId, " + col.Name.ToUpper() + ", pParams." + colName + ");");
				}
			}
		}
		output.tabLevel = oldTabLevel;
	}

	// Ausgabe der Aufrufe SetDbParameter(...) für alle Spalten der Tabelle
	// Beispiel:
	// SetDbParameter(qryResultId, KonditionsartColDefs.MANDANT, pContext.Mandant);
	private void OutputDbParameterDAO(IColumns pColumns, string pNormTimeToColumns, Dictionary<string,string> pDbReaderDatatypeCols, string pEntityname)
	{
		int oldTabLevel = output.tabLevel;
		output.tabLevel = 3;
		foreach(Column col in pColumns)
		{
			string colName = GeneratorHelper.ConvertName(col.Name);
			if(col.Name.Equals(GELOESCHT))
			{
				output.autoTabLn("if(!pParams.Prm" + colName + ".Equals(string.Empty))");
				output.autoTabLn("{");
				output.tabLevel = 4;
				output.autoTabLn("DbReaderHelper.Instance.SetDbParameter(qryResultId, " + col.Name.ToUpper() + ", pParams.Prm" + colName + ");");
				output.tabLevel = 3;
				output.autoTabLn("}");

				// IN-Abfragen fuer Geloescht-Spalten:
				output.autoTabLn("else if(null != pParams.GetPrm" + colName + "_Array())");
				output.autoTabLn("{");
				output.tabLevel = 4;
				output.autoTabLn("foreach(string prm in pParams.GetPrm" + colName + "_Array())");
				output.autoTabLn("{");
				output.tabLevel = 5;
				output.autoTabLn("DbReaderHelper.Instance.SetDbParameter(qryResultId, " + col.Name.ToUpper() +", prm, \"in\");");
				output.tabLevel = 4;
				output.autoTabLn("}");
				output.tabLevel = 3;
				output.autoTabLn("}");

				output.autoTabLn("else");
				output.autoTabLn("{");
				output.tabLevel = 4;
				output.autoTabLn("DbReaderHelper.Instance.SetDbParameter(qryResultId, " + col.Name.ToUpper() + ", \"0\");");
				output.tabLevel = 3;
				output.autoTabLn("}");				
			}
			else
			{
				// Numerische Felder bekommen VON_ sowie BIS_ Parameter zusätzlich. Mandant und Buchungskreis sind ausgenommen, da diese nicht vom Nutzer eingegeben werden.
				if((GeneratorHelper.IsNumeric(col, pDbReaderDatatypeCols)) && (MANDANT != col.Name.ToUpper()) && (BUCHUNGSKREIS != col.Name.ToUpper()))
				{
					if(IsColumnInList(colName, pNormTimeToColumns))
					{
						normtimeColumnFound = true;
						output.autoTabLn("DbReaderHelper.Instance.SetDbParameter(qryResultId, VON_" + col.Name.ToUpper() + ", NormalizeDateTimeAsString( pParams.PrmVon_" + colName + ", false));");
						output.autoTabLn("DbReaderHelper.Instance.SetDbParameter(qryResultId, BIS_" + col.Name.ToUpper() + ", NormalizeDateTimeAsString( pParams.PrmBis_" + colName + ", false));");
						output.autoTabLn("DbReaderHelper.Instance.SetDbParameter(qryResultId, " + col.Name.ToUpper() + ", NormalizeDateTimeAsString( pParams.Prm" + colName + ", false));");
					}
					// Numerische nicht-DateTime-Attribute bekommen zusätzliche Validierung, um fehlerhafte Suchparameter für '='-Anfragen auszuschließen.
					else
					{
						// Prüfung auf gültigen numerischen Wert nur für numerische Datentypen, nicht für DateTime durchführen.
						if (col.LanguageType.ToLower() != "datetime")
						{
							output.autoTabLn("try");
							output.autoTabLn("{");
							output.tabLevel = 4;
							output.autoTabLn("if(!pParams.PrmVon_" + colName + ".Equals(string.Empty))");
							output.tabLevel = 5;
							output.autoTabLn("StandardValidator.ValidateNumericField( pParams.PrmVon_" + colName + ");");
							output.tabLevel = 4;
							output.autoTabLn("if(!pParams.PrmBis_" + colName + ".Equals(string.Empty))");
							output.tabLevel = 5;
							output.autoTabLn("StandardValidator.ValidateNumericField( pParams.PrmBis_" + colName + ");");
							output.tabLevel = 4;
							output.autoTabLn("if(!pParams.Prm" + colName + ".Equals(string.Empty))");
							output.tabLevel = 5;
							output.autoTabLn("StandardValidator.ValidateNumericField( pParams.Prm" + colName + ");");
							output.tabLevel = 3;
							output.autoTabLn("}");
							output.autoTabLn("catch( ValidationException e)");
							output.autoTabLn("{");
							output.tabLevel = 4;
							output.autoTabLn("e.DbFieldInfo = " + col.Name.ToUpper() + ";");
							output.autoTabLn("throw;");
							output.tabLevel = 3;
							output.autoTabLn("}");
							output.autoTabLn("catch( Exception e)");
							output.autoTabLn("{");
							output.tabLevel = 4;
							output.autoTabLn("throw new BusinessLogicException(\"UNEXPECTED_EXCEPTION\", e);");
							output.tabLevel = 3;
							output.autoTabLn("}");
						}
						output.tabLevel = 4;
						output.autoTabLn("if(!pParams.PrmVon_" + colName + ".Equals(string.Empty))");
						output.tabLevel = 5;
						output.autoTabLn("DbReaderHelper.Instance.SetDbParameter(qryResultId, VON_" + col.Name.ToUpper() + ", pParams.PrmVon_" + colName + ");");
						output.tabLevel = 4;
						output.autoTabLn("if(!pParams.PrmBis_" + colName + ".Equals(string.Empty))");
						output.tabLevel = 5;
						output.autoTabLn("DbReaderHelper.Instance.SetDbParameter(qryResultId, BIS_" + col.Name.ToUpper() + ", pParams.PrmBis_" + colName + ");");
						output.tabLevel = 4;
						output.autoTabLn("if(!pParams.Prm" + colName + ".Equals(string.Empty))");
						output.tabLevel = 5;
						output.autoTabLn("DbReaderHelper.Instance.SetDbParameter(qryResultId, " + col.Name.ToUpper() + ", pParams.Prm" + colName + ");");
						output.tabLevel = 4;
					}
				}
				// Nichtnumerische Felder bekommen weder VON_ und BIS-Parameter, noch gesonderte Validierungen.
				else
				{
					// Normalisierte Bis-Werte bekommen ihre Uhrzeit auf 23:59:00 gesetzt, damit die Suche nach genau so heraus geschriebenen Werten funktioniert.
					if(IsColumnInList(colName, pNormTimeToColumns))
					{
						normtimeColumnFound = true;
						output.tabLevel = 4;
						output.autoTabLn("if(!pParams.Prm" + colName + ".Equals(string.Empty))");
						output.tabLevel = 5;
						output.autoTabLn("DbReaderHelper.Instance.SetDbParameter(qryResultId, " + col.Name.ToUpper() + ", NormalizeDateTimeAsString( pParams.Prm" + colName + ", false));");
						output.tabLevel = 4;
					}
					else
					{
						output.tabLevel = 4;
						output.autoTabLn("if(!pParams.Prm" + colName + ".Equals(string.Empty))");
						output.tabLevel = 5;
						output.autoTabLn("DbReaderHelper.Instance.SetDbParameter(qryResultId, " + col.Name.ToUpper() + ", pParams.Prm" + colName + ");");
						output.tabLevel = 4;
					}
				}

				// IN-Abfragen fuer sonstige Spalten:
				output.autoTabLn("if(null != pParams.GetPrm" + colName + "_Array())");
				output.autoTabLn("{");
				output.tabLevel = 4;
				output.autoTabLn("foreach(string prm in pParams.GetPrm" + colName + "_Array())");
				output.autoTabLn("{");
				output.tabLevel = 5;
				output.autoTabLn("DbReaderHelper.Instance.SetDbParameter(qryResultId, " + col.Name.ToUpper() +", prm, \"in\");");
				output.tabLevel = 4;
				output.autoTabLn("}");
				output.tabLevel = 3;
				output.autoTabLn("}");
			}
		}
		output.tabLevel = oldTabLevel;
	}

	// Ausgabe der Methodenaufrufe zum Prüfen der einzelnen Felder
	// Beispiel:
	// Konditionsart_IdValidate(pContext, pData);
	private void OutputValidateAllFields(IColumns pColumns, bool pForDataSet)
	{
		int oldTabLevel = output.tabLevel;
		string parameterName;
		if(pForDataSet)
		{
			output.tabLevel = 4;
			parameterName = "pData";
		}
		else
		{
			output.tabLevel = 3;
			parameterName = "pRow";
		}
		foreach(Column col in pColumns)
		{
			// Boolsche Felder, die keine Mussfelder sind, werden nicht geprüft
			if((col.LanguageType.ToLower() == "bool") && (col.IsNullable))
			{
				continue;
			}
			else if(col.Name.ToUpper() == GELOESCHT)
			{
				// Löschkennzeichen als Bitfeld wird nicht geprüft, um Fehler bei der Validierung von
				// neu angelegten Datensätzen zu vermeiden. 
				continue;
			}
			output.autoTabLn(GeneratorHelper.ConvertName(col.Name) + "Validate(pContext, " + parameterName + ");");
		}
		output.tabLevel = oldTabLevel;
	}

	// Generieren der Methoden zum Prüfen der einzelnen Felder
	private void OutputFieldValidationMethods(IColumns pColumns, string pEntityName)
	{
		string objectname = "<undefined>";
		try
		{
			objectname = pColumns[0].Table.Name;
		}
		catch(Exception)
		{
			objectname = pColumns[0].View.Name;
		}
		int oldTabLevel = output.tabLevel;
		foreach(Column col in pColumns)
		{
			// Boolsche Felder, die keine Mussfelder sind, werden nicht geprüft
			if((col.LanguageType.ToLower() == "bool") && (col.IsNullable))
			{
				continue;
			}
			else if(col.Name.ToUpper() == GELOESCHT)
			{
				// Löschkennzeichen als Bitfeld wird nicht geprüft, um Fehler bei der Validierung von
				// neu angelegten Datensätzen zu vermeiden. 
				continue;
			}
			output.tabLevel = 2;
			output.autoTabLn("/// <summary>");
			output.autoTabLn("/// Standardvalidierung für das Feld " + GeneratorHelper.ConvertName(col.Name) + " der Entität " + objectname + ".");
			output.autoTabLn("/// </summary>");
			output.autoTabLn("/// <param name=\"pContext\">Der aktuelle <see cref=\"ClientContext\" />.</param>");
			output.autoTabLn("/// <param name=\"pDao\">Ein VerifiedDAO mit den zu prüfenden Daten</param>");
			output.autoTabLn("/// <exception cref=\"ValidationException\">Wird geworfen, wenn ungültige Einträge in den Spalten gefunden wurden.</exception>");
			output.autoTabLn("/// <exception cref=\"DAODataSetNullException\">Wird geworfen, wenn das gekapselte DataSet <c>null</c> ist.</exception>");
			output.autoTabLn("/// <exception cref=\"DAOInvalidTableNameException\">Wird geworfen, wenn der übergebene Tabellenname nicht im gekapselten DataSet existiert.</exception>");
			output.autoTabLn("/// <exception cref=\"DAOInvalidCurrentRowException\">Wird geworfen, wenn der Index größer als die Anzahl Datensätze in der Tabelle ist.</exception>");
			output.autoTabLn("/// <remarks>");
			output.autoTabLn("/// Es wird immer der erste Datensatz in der Tabelle <c>TD_" + pEntityName + "_List</c> validiert.");
			output.autoTabLn("/// </remarks>");
			output.autoTabLn("public void Validate_" + GeneratorHelper.ConvertName(col.Name) + "(ClientContext pContext, " + pEntityName + "DAO pDao)");
			output.autoTabLn("{");
			output.tabLevel  = 3;
			output.autoTabLn(GeneratorHelper.ConvertName(col.Name) +"Validate(pContext, pDao.GetDataSet());");
			output.tabLevel = 2;
			output.autoTabLn("}");
			output.writeln("");
			if(col.Name.ToUpper() == BUCHUNGSKREIS || col.Name.ToUpper() == MANDANT)
				continue;
			output.autoTabLn("/// <summary>");
			output.autoTabLn("/// Standardvalidierung für das Feld " + GeneratorHelper.ConvertName(col.Name) + " der Entität " + objectname + ".");
			output.autoTabLn("/// </summary>");
			output.autoTabLn("/// <param name=\"pContext\">Der aktuelle <see cref=\"ClientContext\" />.</param>");
			output.autoTabLn("/// <param name=\"pData\">Ein DataSet mit den zu validierenden Daten.</param>");
			output.autoTabLn("/// <exception cref=\"ValidationException\">Wird geworfen, wenn ungültige Einträge in den Spalten gefunden wurden.</exception>");
			output.autoTabLn("/// <exception cref=\"DAODataSetNullException\">Wird geworfen, wenn das gekapselte DataSet <c>null</c> ist.</exception>");
			output.autoTabLn("/// <exception cref=\"DAOInvalidTableNameException\">Wird geworfen, wenn der übergebene Tabellenname nicht im gekapselten DataSet existiert.</exception>");
			output.autoTabLn("/// <exception cref=\"DAOInvalidCurrentRowException\">Wird geworfen, wenn der Index größer als die Anzahl Datensätze in der Tabelle ist.</exception>");
			output.autoTabLn("/// <remarks>");
			output.autoTabLn("/// Es wird immer der erste Datensatz in der Tabelle <c>TD_" + pEntityName + "_List</c> validiert.");
			output.autoTabLn("/// </remarks>");
			output.autoTabLn("public void " + GeneratorHelper.ConvertName(col.Name) + "Validate(ClientContext pContext, DataSet pData)");
			output.autoTabLn("{");
			output.tabLevel  = 3;
			output.autoTabLn(GeneratorHelper.ConvertName(col.Name) +"Validate(pContext, pData, 0);");
			output.tabLevel = 2;
			output.autoTabLn("}");
			output.writeln("");
			output.autoTabLn("/// <summary>");
			output.autoTabLn("/// Standardvalidierung für das Feld " + GeneratorHelper.ConvertName(col.Name) + " der Entität " + objectname + ".");
			output.autoTabLn("/// </summary>");
			output.autoTabLn("/// <param name=\"pContext\">Der aktuelle <see cref=\"ClientContext\" />.</param>");
			output.autoTabLn("/// <param name=\"pData\">Ein DataSet mit den zu validierenden Daten.</param>");
			output.autoTabLn("/// <param name=\"pRowNum\">Der Index der Datenzeile, welche geprüft werden soll</param>");
			output.autoTabLn("/// <exception cref=\"ValidationException\">Wird geworfen, wenn ungültige Einträge in den Spalten gefunden wurden.</exception>");
			output.autoTabLn("/// <exception cref=\"DAODataSetNullException\">Wird geworfen, wenn das gekapselte DataSet <c>null</c> ist.</exception>");
			output.autoTabLn("/// <exception cref=\"DAOInvalidTableNameException\">Wird geworfen, wenn der übergebene Tabellenname nicht im gekapselten DataSet existiert.</exception>");
			output.autoTabLn("/// <exception cref=\"DAOInvalidCurrentRowException\">Wird geworfen, wenn der Index größer als die Anzahl Datensätze in der Tabelle ist.</exception>");
			output.autoTabLn("public void " + GeneratorHelper.ConvertName(col.Name) + "Validate(ClientContext pContext, DataSet pData, int pRowNum)");
			output.autoTabLn("{");			
			output.tabLevel = 3;			
			// Notwendige Prüfungen an Hand der Metadaten der Spalte bestimmen
			if(col.IsInPrimaryKey)
			{
				output.autoTabLn("Validate_PrimaryKeyField(pContext,pData,pRowNum, " + col.Name.ToUpper() + ");");
			}
			else
			{
				if(col.IsNullable == false)
				{
					output.autoTabLn("Validate_RequiredField(pContext, pData, pRowNum, " + col.Name.ToUpper() + ");");
				}
				if(col.LanguageType.ToLower() == "datetime")
				{
					output.autoTabLn("Validate_DateField(pContext, pData, pRowNum, " + col.Name.ToUpper() + ");");
				}
				else if(col.LanguageType.ToLower() == "string")
				{
					output.autoTabLn("Validate_TextField(pContext, pData, pRowNum, " + col.Name.ToUpper() + ", " +  col.CharacterMaxLength + ");");
				}
				else if(col.LanguageType.ToLower() == "bool")
				{
					// Bit-Felder werden nur auf RequiredField geprüft
				}
				else if(col.LanguageType.ToLower() == "guid")
				{
					// Guid-Felder werden nur auf RequiredField geprüft
				}
				else // numerische Felder
				{
					output.autoTabLn("Validate_NumericField(pContext, pData, pRowNum, " + col.Name.ToUpper() + ", " + col.NumericPrecision + ", " + col.NumericScale + ");");
				}
			}
			output.tabLevel = 2;
			output.autoTabLn("}");
			output.writeln("");
			output.autoTabLn("/// <summary>");
			output.autoTabLn("/// Standardvalidierung für das Feld " + GeneratorHelper.ConvertName(col.Name) + " der Entität " + objectname + ".");
			output.autoTabLn("/// </summary>");
			output.autoTabLn("/// <param name=\"pContext\">Der aktuelle <see cref=\"ClientContext\" />.</param>");
			output.autoTabLn("/// <param name=\"pRow\">Eine DataRow mit den zu validierenden Daten.</param>");
			output.autoTabLn("/// <exception cref=\"ValidationException\">Wird geworfen, wenn ungültige Einträge in den Spalten gefunden wurden.</exception>");
			output.autoTabLn("/// <exception cref=\"BusinessLogicException\">Wird geworfen, wenn eine nicht explizit behandelte Exception aufgetreten ist.</exception>");
			output.autoTabLn("public void " + GeneratorHelper.ConvertName(col.Name) + "Validate(ClientContext pContext, DataRow pRow)");
			output.autoTabLn("{");
			output.tabLevel = 3;
			// Notwendige Prüfungen an Hand der Metadaten der Spalte bestimmen
			if(col.IsInPrimaryKey)
			{
				output.autoTabLn("StandardValidator.ValidatePrimaryKeyField(pRow[" + col.Name.ToUpper() + "]);");
			}
			else
			{
				if(col.IsNullable == false)
				{
					output.autoTabLn("Validate_RequiredField(pContext, pRow, " + col.Name.ToUpper() + ");");
				}
				if(col.LanguageType.ToLower() == "datetime")
				{
					output.autoTabLn("Validate_DateField(pContext, pRow, " + col.Name.ToUpper() + ");");
				}
				else if(col.LanguageType.ToLower() == "string")
				{
					output.autoTabLn("Validate_TextField(pContext, pRow, " + col.Name.ToUpper() + ", " +  col.CharacterMaxLength + ");");
				}
				else if(col.LanguageType.ToLower() == "bool")
				{
					// Bit-Felder werden nur auf RequiredField geprüft
				}
				else if(col.LanguageType.ToLower() == "guid")
				{
					// Guid-Felder werden nur auf RequiredField geprüft
				}
				else // numerische Felder
				{
					output.autoTabLn("Validate_NumericField(pContext, pRow, " + col.Name.ToUpper() + ", " + col.NumericPrecision + ", " + col.NumericScale + ");");

				}
			}
			output.tabLevel = 2;
			output.autoTabLn("}");
			output.writeln("");
		}
		output.tabLevel = oldTabLevel;
	}

	// Prüfen, ob Tabelle Spalte Mandant enthält
	private bool CheckForMandantColumn(IColumns pCols, FunctionGenInfo pFunctionGenInfo)
	{
		if(null != pCols)
		{
			foreach(IColumn col in pCols)
			{
				if(col.Name.ToUpper() == MANDANT)
				{
					return true;
				}
			}
		}
		else if (null != pFunctionGenInfo)
		{
			foreach(TvfColumnInfo col in pFunctionGenInfo.FunctionReturnValueColumns)
			{
				if(col.Name.ToUpper() == MANDANT)
				{
					return true;
				}
			}
		}
		return false;
	}

