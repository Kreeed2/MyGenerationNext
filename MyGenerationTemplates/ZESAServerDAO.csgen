		{<%		// Aufruf der Funktion zum Normalisieren der Datumsformate.
				// Normalisiert wird dabei wie folgt: von-Zeiten werden zu 00:00; bis-Zeiten werden zu 23:59.
				if(info.NormTimeFrom == true) 
				{
					ArrayList normFromColumns = GetNormTimeColumns( info.NormTimeFromColumns);
					foreach(string fromColumn in normFromColumns)
					{%>
			<%=entityname%>DAO.<%=fromColumn%>,<%}
				}%>					
		}; 
		
		/// <summary>
