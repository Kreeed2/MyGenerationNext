	// Wandelt die Spaltenliste für Datums-Zeit-Normalisierungen in eine ArrayList um.
	private ArrayList GetNormTimeColumns(string pColumns)
	{
		string[] parts = pColumns.Split(',');
		ArrayList columns = new ArrayList();
		foreach(string col in parts)
		{
			columns.Add(col.Trim());
		}
		return columns;
	}
	
	// Gibt 'true' zurück, wenn die angegebene Spalte eine zu normalisierende Bis-Spalte ist, 'false' sonst.
	// Parameter:	pColumn = Name der zu testenden Spalte
	// 				pColumns = Liste von Spaltennamen, kommagetrennt (z.B. info.NormTimeToColumns)
	private bool IsColumnInList(string pColumn, string pColumns)
	{
		ArrayList toColumns = GetNormTimeColumns(pColumns);
		foreach(string entry in toColumns)
		{
			if(pColumn.ToUpper() == entry.ToUpper())
			{
				return true;
			}
		}
		return false;
	}
	
	// Gibt den Primary Key der Tabelle zurück
	private string GetPrimaryKeyColumnName(string pColumns)
	{
		string[] parts = pColumns.Split(',');
		if(parts.Length > 0)
		{
			return parts[0].Trim();
		}
		else
		{
			return string.Empty;
		}
	}
}
