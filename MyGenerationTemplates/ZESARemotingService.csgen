<%
				// neue Dateien der Projektdatei hinzufügen
				bool addToProject = false;
				if(!File.Exists(filename))
					addToProject = true;
			
				// Save File
				output.save(filename, false);
				output.clear();	
			
				// neue Dateien der Projektdatei hinzufügen
				if(addToProject)
				{
					// Projektdatei auschecken
					TfsHelper.Instance.CheckOut(filePathProjectFile);
					GeneratorHelper.AddFileToProject(Project.Server, fileNameInProject);
					TfsHelper.Instance.Add(filename);
				}		
			}
		}
		// Logging
		output.clear();
		output.writeln("Generierung Service-Klassen erfolgreich beendet...");
		output.writeln("");
		output.writeln("Ausgabeverzeichnis = " + input["TargetPath"]);
		output.writeln("");
		output.writeln("Folgende Dateien wurden generiert:" );
		output.writeln("");
		foreach(string csFile in csFiles)
		{
		    output.writeln(csFile);
		}
		output.writeln("");
		output.writeln("==> Ende <==");
		output.writeln("");
		string logname = input["TargetPath"].ToString();
		if (!logname.EndsWith("\\") ) logname += "\\";
		logname += "ZESA_Generierung_" + DateTime.Now.ToString("yyyyMMdd") + ".log";
		output.append(logname);
    output.clear();	
		MyMeta.SaveUserMetaData();
	}
	
	// Prüfen, ob Tabelle Spalte VERSION_NUM enthält
	private bool CheckForVersionNumColumn(IColumns pCols)
	{
		foreach(IColumn col in pCols)
		{
			if(col.Name.ToUpper() == VERSION_NUM)
			{
				return true;
			}
		}
		return false;
	}
}
