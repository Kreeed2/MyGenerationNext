<%#REFERENCE ZESABLGeneratorUI.dll %><%
using System.Text;
using System.IO;
using EHA.ZESA.Util.GeneratorUI;

public class GeneratedTemplate : DotNetScriptTemplate
{
	private const string VERSION_NUM = "VERSION_NUM";

	public GeneratedTemplate(ZeusContext context) : base(context) {}

	public override void Render()
	{
	  if(input["Data"] == null)
		{
			output.writeln("Cancelled by user ... ");
			return;
		}
		ArrayList data = input["Data"] as ArrayList;
		ArrayList csFiles = new ArrayList();
		string filepath;

		foreach(GenInfo info in data)
		{
		  IColumns cols;
			string entityname;
			string entitynameUpper;
			
			// RemotingService-Klassen werden nur für Tabellen erzeugt
			if(info.ObjectType == "Table")
			{
				ITable table = MyMeta.DefaultDatabase.Tables[info.ObjectName];
				cols = table.Columns;
				entityname = GeneratorHelper.ConvertName(info.EntityName);
				entitynameUpper = info.EntityName;
				
				// Zeiger ob eine Versionsnummer und damit die Updatelogik über
				// Prozedur vorhanden ist
				bool hasVersionNum = CheckForVersionNumColumn(cols);
			
				// Klassennamen bilden
				string classname     = entityname + "Service";
				string fullClassname = "EHA.ZESA.Server.RemotingService." + info.Namespace + "." + classname;
				string fileNameInProject = "RemotingService\\" + info.Namespace + "\\" + classname + ".cs";

				// Dateinamen bilden
				filepath = input["TargetPath"].ToString();
				if (!filepath.EndsWith("\\") ) filepath += "\\";
				string filePathProjectFile = filepath + "Server\\ZESAServer\\ZESAServer.csproj";
				filepath += "Server\\ZESAServer\\RemotingService\\" + info.Namespace + "\\";
				
				// Verzeichnis bei Bedarf anlegen
				if(!Directory.Exists(filepath))
				{
					Directory.CreateDirectory(filepath);
				}
				string filename = filepath + classname + ".cs";
				
				// File ausschecken
				TfsHelper.Instance.CheckOut(filename);
				
				// Dateinamen für Logging zwischenspeichern
				csFiles.Add(fullClassname);
				
				// geschützten Bereich im Source definieren
				output.setPreserveSource(filename, "/***", "***/");
if (info.UsesOldDataSetLogic){
